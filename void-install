sh_getBootEFI() {
	if [ -d /sys/firmware/efi ]; then
		TARGET_EFI=x86_64-efi
		if [ -r /sys/firmware/efi/fw_platform_size ] &&
			[ "$(cat /sys/firmware/efi/fw_platform_size)" -eq 32 ]; then
			TARGET_EFI=i386-efi
		fi
		return 0
	fi
	return 1
}

