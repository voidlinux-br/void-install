	str+="\n"

	for i in $(echo "${!Amntpoint[@]}" | tr ' ' '\n' | sort); do
		str+="$(printf "%-${nlen}s" "$i")	\
$(printf "$sep%-${nlen}s" "$(sh_splitarray "${AARRAY_PART_DEVICES[$i]}" 7)")	\
$(printf "$sep%-${nlen}s" "$(sh_splitarray "${AARRAY_PART_DEVICES[$i]}" 2)")	\
