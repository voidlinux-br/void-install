is_valid_fs() {
	local cFs="$1"
	local cPath="$2"
	local xtitle

	case "$cPath" in
	"/")
		case "$cFs" in
		xfs | f2fs | ext2 | ext3 | ext4 | btrfs | jfs | nilfs2)
			return 0
			;;
		*)
			xtitle="${RED}FILESYSTEM ERROR${RST}\
\n$(gettext 'Filesystem inválido para') ${CYAN}'${cPath}' ${RST}=> ${cFs} \
\n${YELLOW}$(gettext 'Válidos:') ${CYAN}xfs|f2fs|ext2|ext3|ext4|btrfs|jfs"

			if sh_choose_fstype "${AsFs[root]}" "$xtitle"; then
				AsFs[root]="${AConfDisk[_FILESYSTEM]}"
				return 1
			fi
			return 1
			;;
		esac
		;;

	"/home")
		case "$cFs" in
		xfs | f2fs | ext2 | ext3 | ext4 | vfat | ntfs | btrfs | jfs | nilfs2)
			return 0
			;;
		*)
			xtitle="${RED}FILESYSTEM ERROR${RST} \
\n$(gettext 'Filesystem inválido para') ${CYAN}'${cPath}' ${RST}=> ${cFs} \
\n${YELLOW}$(gettext 'Válidos:') ${CYAN}xfs|f2fs|ext2|ext3|ext4|vfat|ntfs|btrfs|jfs"

			if sh_choose_fstype "${AsFs[home]}" "$xtitle"; then
				AsFs[home]="${AConfDisk[_FILESYSTEM]}"
				return 1
			fi
			return 1
			;;
		esac
		;;

	"/boot")
		case "$cFs" in
		xfs | f2fs | ext2 | ext3 | ext4 | vfat | btrfs | jfs)
			return 0
			;;
		*)
			xtitle="${RED}FILESYSTEM ERROR${RST} \
\n$(gettext 'Filesystem inválido para') ${CYAN}'${cPath}' ${RST}=> ${cFs} \
\n${YELLOW}$(gettext 'Válidos:') ${CYAN}xfs|f2fs|ext2|ext3|ext4|vfat|btrfs|jfs"

			if sh_choose_fstype "${AsFs[boot]}" "$xtitle"; then
				AsFs[boot]="${AConfDisk[_FILESYSTEM]}"
				return 1
			fi
			return 1
			;;
		esac
		;;
	esac

	return 1
}

# Pergunta se o usuário quer criptografar o disco (LUKS) antes de particionar.
# Chamada no início de sh_getPartitionsPercent, pois a resposta muda o layout
# oferecido na tela seguinte (com LUKS, boot/swap/home não são partições
# físicas separadas).
sh_ask_partition_mode() {
	local choice

	while true; do
		choice=$(${DIALOG} --stdout --colors \
			--backtitle "$ccabec" \
			--title "=== $(gettext 'MODO DE PARTICIONAMENTO') ===" \
			--ok-label "${cmsg_Aceitar}" \
			--radiolist "\n$(gettext 'Como deseja particionar o disco?')" \
			14 70 3 \
			"normal" "$(gettext 'Normal - Partições físicas tradicionais (root/boot/swap/home)')" "on" \
			"lvm" "$(gettext 'LVM - Usar gerenciador de volumes lógicos (sem criptografia)')" "off" \
			"fde" "$(gettext 'FDE - Encriptar o disco (LUKS) com LVM')" "off")

		case "$choice" in
		normal)
			LFDE=false
			LVM=false
			return 0
			;;
		lvm)
			# Já escolheu "lvm" no menu — o padrão aqui é "Sim" (conf, não
			# notconf), só confirma; ainda dá pra desistir escolhendo "Não".
			if conf "=== $(gettext 'LVM') ===" \
				"\n$(gettext 'Deseja usar LVM (Logical Volume Manager) para este disco?')\n" \
				"\n${YELLOW}$(gettext 'Se sim, /boot, swap e /home NÃO serão partições separadas: tudo ficará dentro do grupo de volumes, como volumes lógicos configurados a seguir.')${RST}"; then
				LFDE=false
				LVM=true
				return 0
			else
				continue # respondeu "Não" -> volta pro menu de 3 opções
			fi
			;;
		fde)
			# Já escolheu "fde" no menu — o padrão aqui é "Sim" (conf, não
			# notconf), só confirma; ainda dá pra desistir escolhendo "Não".
			if conf "=== $(gettext 'CRIPTOGRAFIA DE DISCO') (LUKS) ===" \
				"\n$(gettext 'Deseja criptografar este disco com LUKS (Full Disk Encryption)?')\n" \
				"\n${YELLOW}$(gettext 'Se sim, /boot, swap e /home NÃO serão partições separadas: tudo ficará dentro do container criptografado, como volumes lógicos configurados a seguir.')${RST}"; then
				LFDE=true
				LVM=true
				return 0
			else
				continue # respondeu "Não" -> volta pro menu de 3 opções
			fi
			;;
		*)
			return 1 # ESC/Cancelar
			;;
		esac
	done
}

sh_getPartitionsPercent() {
	local -a aPercent=()
	local percent_text
	local disk_size="${SIZE_ORIGEM}"
	local lattr=0
	AsDiskPercent[_DISKTABLE]="${AConfDisk[_DISKTABLE]}"
	xtitle="${AConfDisk[_DEVICE]} - $(gettext "Configuração de Partições")"

	sh_ask_partition_mode
	if $LFDE || $LVM; then
		# Com LUKS e/ou LVM ativo, tudo (boot/swap/home) vira volume lógico
		# dentro do container/VG, configurado depois em sh_confLvm — não faz
		# sentido oferecer essas partições como físicas aqui. root sempre 100%.
		lattr=2
		AsDiskPercent[root]=100
		AsDiskPercent[boot]=0
		AsDiskPercent[home]=0
		AsDiskPercent[swap]=0
	fi

	AsDiskSize[root]="$(sh_get_part_size ${SIZE_ORIGEM} ${AsDiskPercent[root]})G"
	AsDiskSize[boot]="$(sh_get_part_size ${SIZE_ORIGEM} ${AsDiskPercent[boot]})G"
	AsDiskSize[home]="$(sh_get_part_size ${SIZE_ORIGEM} ${AsDiskPercent[home]})G"
	AsDiskSize[swap]="$(sh_get_part_size ${SIZE_ORIGEM} ${AsDiskPercent[swap]})G"

	total=$((AsDiskPercent[root] + AsDiskPercent[boot] + AsDiskPercent[home] + AsDiskPercent[swap]))

	# loop principal
	while :; do
		percent_text=$(
			"${DIALOG}" \
				--stdout \
				--colors \
				--backtitle "$ccabec" \
				--title "${xtitle}" \
				--ok-label "${cmsg_Aceitar}" \
				--cancel-label "${cmsg_ButtonCancelar}" \
				--extra-button \
				--extra-label "Recalcular" \
				--help-button \
				--help-label "Ajuda" \
				--mixedform "\
\n➡   ${YELLOW}$(gettext "Configure os percentuais desejados.")${RST} \
\n➡   ${CYAN}$(gettext "Use o botao ajuda para informações.")${RST}" \
				15 100 0 \
				\
				"Mode" 1 01 "${AsDiskPercent[_DISKTABLE]}" 1 24 15 15 2 \
				"root (/) (%)" 2 01 "${AsDiskPercent[root]}" 2 24 05 05 $lattr \
				"" 2 14 "${AsDiskSize[root]}" 2 14 10 10 2 \
				"FS" 2 32 "${AsFs[root]:-ext4}" 2 37 10 10 0 \
				"/boot    (%)" 3 01 "${AsDiskPercent[boot]}" 3 24 05 05 $lattr \
				"" 3 14 "${AsDiskSize[boot]}" 3 14 10 10 2 \
				"FS" 3 32 "${AsFs[boot]:-ext4}" 3 37 10 10 $lattr \
				"/home    (%)" 4 01 "${AsDiskPercent[home]}" 4 24 05 05 $lattr \
				"" 4 14 "${AsDiskSize[home]}" 4 14 10 10 2 \
				"FS" 4 32 "${AsFs[home]:-ext4}" 4 37 10 10 $lattr \
				"swap     (%)" 5 01 "${AsDiskPercent[swap]}" 5 24 05 10 $lattr \
				"" 5 14 "${AsDiskSize[swap]}" 5 14 10 10 2 \
				"FS" 5 32 "${AsFs[swap]:-swap}" 5 37 10 10 2 \
				"TOTAL    (%)" 6 01 "${total}" 6 24 05 10 2
		)

		exit_status=$?

		# cancelar / esc
		case "$exit_status" in
		"$D_ESC" | "$D_CANCEL")
			return 1
			;;
		"$D_EXTRA")
			sh_recalculate
			continue
			;;
		"$D_AJUDA")
			infoextended "${YELLOW}$(gettext "Configure os percentuais desejados.")${RST}" \
				"⚠   ROOT + BOOT + SWAP + HOME $(gettext "não pode ultrapassar") ${RED}100% ${RST}
\n➡   $(gettext "Você também pode utilizar menos de 100% do disco")" \
				"\n\n${GREEN}$(gettext "Exemplos válidos:")${RST} \
\nroot(/)=${RED}100 ${RST} /boot=${RED}0 ${RST}/home=${RED}0  ${RST}swap=${RED}0 ${RST} \
\nroot(/)=${RED}35  ${RST} /boot=${RED}5 ${RST}/home=${RED}55 ${RST}swap=${RED}5 ${RST} \
\nroot(/)=${RED}50  ${RST} /boot=${RED}0 ${RST}/home=${RED}0  ${RST}swap=${RED}0 ${RST}" \
				"\n\n➡   $(gettext 'Informe') BOOT $(gettext 'como') ${YELLOW}0${RST} $(gettext 'para não criar partição') BOOT $(gettext 'separada.') \
\n➡   $(gettext 'Informe') HOME $(gettext 'como') ${YELLOW}0${RST} $(gettext 'para não criar partição') HOME $(gettext 'separada.') \
\n➡   $(gettext 'Informe') SWAP $(gettext 'como') ${YELLOW}0${RST} $(gettext 'para não criar partição') SWAP"
			continue
			;;
		esac

		sh_recalculate() {
			# captura retorno
			mapfile -t aPercent <<<"$percent_text"
			AsDiskPercent[root]="${aPercent[1]}"
			AsDiskPercent[boot]="${aPercent[4]}"
			AsDiskPercent[home]="${aPercent[7]}"
			AsDiskPercent[swap]="${aPercent[10]}"

			AsFs[root]="${aPercent[3]}"
			AsFs[boot]="${aPercent[6]}"
			AsFs[home]="${aPercent[9]}"

			AsDiskSize[root]="$(sh_get_part_size ${SIZE_ORIGEM} ${AsDiskPercent[root]})G"
			AsDiskSize[boot]="$(sh_get_part_size ${SIZE_ORIGEM} ${AsDiskPercent[boot]})G"
			AsDiskSize[home]="$(sh_get_part_size ${SIZE_ORIGEM} ${AsDiskPercent[home]})G"
			AsDiskSize[swap]="$(sh_get_part_size ${SIZE_ORIGEM} ${AsDiskPercent[swap]})G"

			total=$((AsDiskPercent[root] + AsDiskPercent[boot] + AsDiskPercent[home] + AsDiskPercent[swap]))
		}

		sh_recalculate

		if [ "${AsDiskPercent[root]}" -gt 0 ]; then
			if ! is_valid_fs "${AsFs[root]}" "/"; then
				continue
			fi
		fi

		if [ "${AsDiskPercent[boot]}" -gt 0 ]; then
			if ! is_valid_fs "${AsFs[boot]}" "/boot"; then
				continue
			fi
		fi

		if [ "${AsDiskPercent[home]}" -gt 0 ]; then
			if ! is_valid_fs "${AsFs[home]}" "/home"; then
				continue
			fi
		fi

		# valida ROOT
		case "${AsDiskPercent[root]}" in
		'' | *[!0-9]*)
			info \
				"${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\n$(gettext "Valor inválido para ROOT.")" \
				"\n$(gettext "ROOT deve estar entre 1 e 100.")"
			continue
			;;
		esac

		# valida BOOT
		case "${AsDiskPercent[boot]}" in
		'' | *[!0-9]*)
			info \
				"${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\n$(gettext "Valor inválido para BOOT.")" \
				"\n$(gettext "BOOT deve estar entre 0 e 99.")"
			continue
			;;
		esac

		# valida HOME
		case "${AsDiskPercent[home]}" in
		'' | *[!0-9]*)
			info \
				"${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\n$(gettext "Valor inválido para HOME.")" \
				"\n$(gettext "HOME deve estar entre 0 e 99.")"
			continue
			;;
		esac

		# valida SWAP
		case "${AsDiskPercent[swap]}" in
		'' | *[!0-9]*)
			info "${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\n$(gettext "Valor inválido para SWAP.")" \
				"\n$(gettext "SWAP deve estar entre 0 e 99.")"
			continue
			;;
		esac

		# faixa ROOT
		if [ "${AsDiskPercent[root]}" -lt 1 ] || [ "${AsDiskPercent[root]}" -gt 100 ]; then
			info \
				"${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\n$(gettext "ROOT deve estar entre 1 e 100.")"
			continue
		fi

		# faixa BOOT
		if [ "${AsDiskPercent[boot]}" -lt 0 ] || [ "${AsDiskPercent[boot]}" -gt 99 ]; then
			info \
				"${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\n$(gettext "BOOT deve estar entre 0 e 99.")"
			continue
		fi

		# faixa HOME
		if [ "${AsDiskPercent[home]}" -lt 0 ] || [ "${AsDiskPercent[home]}" -gt 99 ]; then
			info \
				"${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\n$(gettext "HOME deve estar entre 0 e 99.")"
			continue
		fi

		# faixa SWAP
		if [ "${AsDiskPercent[swap]}" -lt 0 ] || [ "${AsDiskPercent[swap]}" -gt 99 ]; then
			info \
				"${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\n$(gettext "SWAP deve estar entre 0 e 99.")"
			continue
		fi

		# soma
		total=$((AsDiskPercent[root] + AsDiskPercent[boot] + AsDiskPercent[home] + AsDiskPercent[swap]))

		if [ "$total" -gt 100 ]; then
			info \
				"${AConfDisk[_DEVICE]} - ${RED}${cmsg_ERRO}${RST}" \
				"\nROOT + BOOT + HOME + SWAP $(gettext "não pode ultrapassar") ${RED}100% ${RST}" \
				"$(gettext "Valor atual:") ${RED}${total}%${RST}"
			continue
		fi

		# tudo OK
		#    if conf "${xtitle}" \
		#             "\n${BOLD}${RED}$(gettext 'Deseja reviser o particionamento ?')" \
		#             "\n$(gettext 'Não para aceitar!')"; then
		#      sh_recalculate
		#    else
		#      break
		#    fi

		if ! confRevisar "${YELLOW}${cwarning}" \
			"DEVICE  : ${RED}${AConfDisk[_DEVICE]}${RESET}\n" \
			"MODEL   : ${RED}${MODEL_ORIGEM}${RST}\n\n" \
			"/       : ${CYAN}${AsDiskSize[root]} ${YELLOW}${AsFs[root]} ${RST}\n" \
			"/boot   : $([ "${AsDiskPercent[boot]}" -eq 0 ] && echo "${YELLOW}sem /boot separado${RST}" || echo "${CYAN}${AsDiskSize[boot]} ${YELLOW}${AsFs[boot]}${RST}")\n" \
			"swap    : $([ "${AsDiskPercent[swap]}" -eq 0 ] && echo "${YELLOW}sem partição swap${RST}" || echo "${CYAN}${AsDiskSize[swap]} ${YELLOW}${AsFs[swap]}${RST}")\n" \
			"/home   : $([ "${AsDiskPercent[home]}" -eq 0 ] && echo "${YELLOW}sem /home separado${RST}" || echo "${CYAN}${AsDiskSize[home]} ${YELLOW}${AsFs[home]}${RST}")\n" \
			"\n${RED}${cmsg_todos_os_dados_serao_perdidos}${RESET}" \
			"\n\n${BOLD}${CYAN}$(gettext 'Deseja prosseguir ou revisar com o particionamento ?')"; then
			sh_recalculate
		else
			break
		fi
	done

	[[ ${AsFs[boot]} == vfat ]] && AsFs[boot]="fat32"
	withhome=true
	withboot=true
	withswap=true
	[[ "${AsDiskPercent[boot]}" -eq 0 ]] && withboot=false
	[[ "${AsDiskPercent[home]}" -eq 0 ]] && withhome=false
	[[ "${AsDiskPercent[swap]}" -eq 0 ]] && withswap=false
	#info "${cmsg_Disco}" "BOOT separado: ${withboot}" "HOME separado: ${withhome}" "SWAP separado: ${withswap}"
	return 0

}

sh_checkSpaceToSwap() {
	if [[ $(sh_toBytes "$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_DEVICE]}]}" 2)") -lt $(sh_toBytes "4G") ]]; then
		if ! infoconf "${cmsg_Disco}" "$(fdisk -l "${AConfDisk[_DEVICE]}")" \
			"${YELLOW}${AConfDisk[_DEVICE]} - ${cmsg_CriandoPartSwap}" \
			"\n${cmsg_TamanhoInsuficiente}\n${cmsg_DesejaProsseguir}"; then
			return 1
		fi
		withswap=false
	else
		if ! infoconf "${AConfDisk[_DEVICE]} - ${cmsg_Disco}" "$(fdisk -l "${AConfDisk[_DEVICE]}")" \
			"${AConfDisk[_DEVICE]} - ${YELLOW}${cmsg_CriandoPartSwap}" \
			"\n${cmsg_DesejaCriarParticaoSwap}"; then
			withswap=false
			return 1
		fi
	fi
	return 0
}

sh_close_stale_crypto() {
	local device="$1"
	local mapper name vg backing

	[[ -n "$device" ]] || return 0

	# Sem isso, pvs/vgs às vezes enxergam um cache desatualizado do LVM (visto
	# em testes: vgs/vgchange diziam "not found" pra um VG que o vgremove
	# logo depois conseguia remover normalmente) — força releitura real do
	# disco antes de checar. vgscan atualiza o cache tradicional; pvscan
	# --cache reconstrói especificamente o cache de "hints" do LVM, que foi
	# a causa raiz confirmada de "skip hint hash but found label" nos logs.
	vgscan >/dev/null 2>&1
	pvscan --cache >/dev/null 2>&1

	for mapper in /dev/mapper/*; do
		[[ -e "$mapper" && "$mapper" != "/dev/mapper/control" ]] || continue
		name=$(basename "$mapper")

		# só interessa mapeamentos crypt (LUKS) cujo dispositivo de origem
		# seja uma partição do disco alvo (ex: /dev/sda3)
		backing=$(cryptsetup status "$name" 2>/dev/null | awk -F': ' '/device:/ {print $2}' | tr -d ' ')
		[[ -n "$backing" && "$backing" == "${device}"* ]] || continue

		# se houver VG em cima desse mapper, desativa primeiro
		vg=$(pvs --noheadings -o vg_name "$mapper" 2>/dev/null | tr -d ' ')
		[[ -n "$vg" ]] && vgchange -an "$vg" >/dev/null 2>&1

		cryptsetup luksClose "$name" >/dev/null 2>&1
	done
}

# Complementa sh_close_stale_crypto pro caso sem LUKS: se o dispositivo alvo
# já pertence a um VG ativo (ex: instalação anterior abortada sem limpar,
# deixando o VG/LVM pendurado), desativa e remove esse VG antes de tentar
# criar um novo em cima do mesmo dispositivo.
sh_close_stale_lvm() {
	local device="$1"
	local pv vg

	[[ -n "$device" ]] || return 0

	# Mesmo motivo do sh_close_stale_crypto: sem forçar releitura, pvs pode
	# reportar "nada encontrado" mesmo com um VG de verdade ativo no disco.
	vgscan >/dev/null 2>&1
	pvscan --cache >/dev/null 2>&1

	while read -r pv vg; do
		[[ -n "$pv" && "$pv" == "${device}"* ]] || continue
		[[ -n "$vg" ]] || continue
		vgchange -an "$vg" >/dev/null 2>&1
		vgremove -ff "$vg" >/dev/null 2>&1

		# vgremove só desregistra o VG da visão ativa do LVM — a assinatura
		# em si pode continuar gravada no disco, e um vgscan completo mais
		# tarde "redescobre" esse mesmo VG como se nunca tivesse sido
		# removido. Apaga a assinatura de verdade, nos dois níveis.
		pvremove -ff -y "$pv" >/dev/null 2>&1
		wipefs -a "$pv" >/dev/null 2>&1
	done < <(pvs --noheadings -o pv_name,vg_name 2>/dev/null)
}

sh_mkparted() {
	local silent="${1:-false}"
	local nchoice=false
	local withboot=true
	local withhome=true
	local withswap=true
	local label_type='gpt'
	local ext=$(sh_getNvme)
	local cini=''
	local cnextpart=''
	local CSCRIPT=''
	local _p

	# Fecha qualquer LUKS/LVM remanescente de um teste anterior que ainda
	# esteja ativo em cima de uma partição deste disco (ou deste LV, se o
	# alvo for um volume lógico), para evitar falha do kernel ao reler a
	# tabela de partições ("dispositivo ocupado"). Cobre tanto container
	# LUKS quanto VG puro (sem criptografia) — usa correspondência por
	# prefixo, então funciona passando o disco inteiro (pega qualquer
	# partição dele que esteja com resíduo).
	sh_close_stale_crypto "${AConfDisk[_DEVICE]}"
	sh_close_stale_lvm "${AConfDisk[_DEVICE]}"

	# Comentado a pedido — todo o bloco, inclusive o fdisk -l (lento) e o
	# aviso associado. Talvez volte a ser usado no futuro.
	# sh_info_msg "${cmsg_TestandoDisco} ${AConfDisk[_DEVICE]}"
	# if ! sh_testDisk; then
	#   die "${cmsg_ErroLeituraDisco}: ${AConfDisk[_DEVICE]}."
	# fi
	#
	# if ! ((grafico)); then
	#   if ! ((quiet)); then
	#     replicate "=" "$COLUMNS"
	#     if ! fdisk -l "${AConfDisk[_DEVICE]}"; then
	#       die "${cmsg_ErroLeituraDisco}: ${AConfDisk[_DEVICE]}."
	#     fi
	#     replicate "=" "$COLUMNS"
	#     if ! $LMKPARTED; then
	#       echo "${yellow}${cwarning} ${red}${cmsg_todos_os_dados_serao_perdidos}${reset}"
	#     fi
	#   fi
	# fi

	#	if $LMKPARTED; then
	#		return 0
	#	fi

	if ! ((grafico)); then
		if readconf "${red}${cmsg_ContinuarParticionamento} ${yellow}${AConfDisk[_DEVICE]} ${reset}?"; then
			nchoice=true
		fi
	else
		#		if [[ $(sh_toBytes "$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_DEVICE]}]}" 2)") -lt $(sh_toBytes "4G") ]]; then
		#			if ! infoconf "${cmsg_Disco}" "$(fdisk -l "${AConfDisk[_DEVICE]}")" \
		#				"${YELLOW}${AConfDisk[_DEVICE]} - ${cmsg_CriandoPartSwap}" \
		#				"\n${cmsg_TamanhoInsuficiente}\n${cmsg_DesejaProsseguir}"; then
		#				return 1
		#			fi
		#			withswap=false
		#		else
		#			if ! infoconf "${AConfDisk[_DEVICE]} - ${cmsg_Disco}" "$(fdisk -l "${AConfDisk[_DEVICE]}")" \
		#				"${AConfDisk[_DEVICE]} - ${YELLOW}${cmsg_CriandoPartSwap}" \
		#				"\n${cmsg_DesejaCriarParticaoSwap}"; then
		#				withswap=false
		#			fi
		#		fi

		#   sh_checkSpaceToSwap
		if $silent; then
			# Chamado de dentro de sh_install com LVM/FDE já decidido — força os
			# valores direto (não confia em AsDiskPercent estar correto nesse
			# ponto por algum motivo ainda não identificado; já vimos esse
			# array aparentemente certo e mesmo assim o cálculo falhar). Pra
			# LFDE/LVM o layout é sempre o mesmo: tudo em root, resto zero.
			AsDiskPercent[root]=100
			AsDiskPercent[boot]=0
			AsDiskPercent[swap]=0
			AsDiskPercent[home]=0
			withboot=false
			withswap=false
			withhome=false
		elif ! sh_getPartitionsPercent; then
			info "${AConfDisk[_DEVICE]} - ${cmsg_Disco^^} - AUTOMATIC" \
				"\n$(gettext '✗ Particionamento e formatação automatica cancelado pelo usuário')"
			return 1
		fi

		#		if ! conf "${YELLOW}${cwarning}" \
		#			"DEVICE  : ${RED}${AConfDisk[_DEVICE]}${RESET}\n" \
		#			"MODEL  : ${RED}$MODEL_ORIGEM${RESET}\n" \
		#			"\n${RED}${cmsg_todos_os_dados_serao_perdidos}${RESET}" \
		#			"\n${cmsg_ContinuarParticionamento} ${AConfDisk[_DEVICE]} ?\n"; then
		#      info "${cmsg_Disco} - AUTOMATIC" "\n$(gettext 'Particionamento e formatação automatica cancelado')"
		#			return 1
		#		fi
		#		nchoice=true

		#		if ! infoconf "${AConfDisk[_DEVICE]} - ${cmsg_Disco}" \
		#		  "$(fdisk -l "${AConfDisk[_DEVICE]}")" \
		#			"${YELLOW}${cwarning}" \
		#  		"DEVICE  : ${RED}${AConfDisk[_DEVICE]}${RESET}\n" \
		#	 		"MODEL  : ${RED}$MODEL_ORIGEM${RESET}\n" \
		#	  	"\n${RED}${cmsg_todos_os_dados_serao_perdidos}${RESET}" \
		#  		"\n${cmsg_ContinuarParticionamento} ${AConfDisk[_DEVICE]} ?\n"; then
		#      info "${AConfDisk[_DEVICE]} - ${cmsg_Disco^^} - AUTOMATIC" \
		#           "\n$(gettext '✗ Particionamento e formatação automatica cancelado pelo usuário')"
		#	 		return 1
		#  	fi
		#		nchoice=true
		nchoice=true
	fi

	if $nchoice; then
		sh_info_msg "${cmsg_CriandoParticoes} ${AConfDisk[_DEVICE]}"
		if [[ "${AConfDisk[_DISKTABLE]}" = "EFI" || "${AConfDisk[_DISKTABLE]}" = "GPT_BIOS" ]]; then
			label_type='gpt'
		else
			label_type='msdos'
		fi

		Amntpoint=()
		AsFs+=([_DEVICE]="${AConfDisk[_DEVICE]}")
		CSCRIPT+="mklabel $label_type "

		if [[ "$label_type" = "gpt" ]]; then
			#bios
			cnextpart=0
			cini="2MiB"
			cnextini="4MiB"
			((++cnextpart))
			CSCRIPT+="mkpart primary fat32 ${cini} ${cnextini} set 1 bios_grub on name 1 BIOS "
			Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}${cnextpart}"]="none|-|0")

			#efi
			((++cnextpart))
			cini="${cnextini}"
			cnextini="512MiB"
			CSCRIPT+="mkpart primary fat32 ${cini} ${cnextini} set 2 esp       on name 2 EFI  "
			Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}2"]="/boot/efi|vfat|1")
			cini="${cnextini}"

			#boot
			if $withboot; then
				((++cnextpart))
				cnextpercent=$((AsDiskPercent[boot]))
				CSCRIPT+="mkpart primary ${AsFs[boot]:-ext4} ${cini} ${cnextpercent}% name ${cnextpart} BOOT "
				Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}${cnextpart}"]="/boot|${AsFs[boot]:-ext4}|1")
				cini="${cnextpercent}%"
			fi

			#swap
			if $withswap; then
				((++cnextpart))
				cnextpercent=$((AsDiskPercent[boot] + AsDiskPercent[swap]))
				CSCRIPT+="mkpart primary linux-swap ${cini} ${cnextpercent}% name ${cnextpart} SWAP "
				Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}${cnextpart}"]="none|swap|1")
				cini="${cnextpercent}%"
			fi

			#root
			((++cnextpart))
			cnextpercent=$((AsDiskPercent[boot] + AsDiskPercent[swap] + AsDiskPercent[root]))
			CSCRIPT+="mkpart primary ${AsFs[root]:-ext4} ${cini} ${cnextpercent}% name ${cnextpart} ROOT "
			Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}${cnextpart}"]="/|${AsFs[root]:-ext4}|1")
			cini="${cnextpercent}%"

			#home
			if $withhome; then
				((++cnextpart))
				((cnextpercent = cnextpercent + AsDiskPercent[home], cnextpercent = cnextpercent >= 99 ? 100 : cnextpercent))
				CSCRIPT+="mkpart primary ${AsFs[home]:-ext4} ${cini} ${cnextpercent}% name ${cnextpart} HOME "
				Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}${cnextpart}"]="/home|${AsFs[home]:-ext4}|1")
			fi

		else
			cnextpart=0
			cini="2MiB"

			#boot
			if $withboot; then
				((++cnextpart))
				cnextpercent=$((AsDiskPercent[boot]))
				CSCRIPT+="mkpart primary ${AsFs[boot]:-ext4} ${cini} ${cnextpercent}% "
				Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}${cnextpart}"]="/boot|${AsFs[boot]:-ext4}|1")
				cini="${cnextpercent}%"
			fi

			#swap
			if $withswap; then
				((++cnextpart))
				cnextpercent=$((AsDiskPercent[boot] + AsDiskPercent[swap]))
				CSCRIPT+="mkpart primary linux-swap ${cini} ${cnextpercent}% "
				Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}${cnextpart}"]="none|swap|1")
				cini="${cnextpercent}%"
			fi

			#root
			((++cnextpart))
			cnextpercent=$((AsDiskPercent[boot] + AsDiskPercent[swap] + AsDiskPercent[root]))
			CSCRIPT+="mkpart primary ${AsFs[root]:-ext4} ${cini} ${cnextpercent}% set ${cnextpart} boot on "
			Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}$cnextpart"]="/|ext4|1")
			cini="${cnextpercent}%"

			#home
			if $withhome; then
				((++cnextpart))
				((cnextpercent = cnextpercent + AsDiskPercent[home], cnextpercent = cnextpercent >= 99 ? 100 : cnextpercent))
				CSCRIPT+="mkpart primary ${AsFs[home]:-ext4} ${cini} ${cnextpercent}% "
				Amntpoint+=(["${AConfDisk[_DEVICE]}${ext}${cnextpart}"]="/home|${AsFs[home]:-ext4}|1")
			fi

		fi

		# wipefs por partição (abaixo, depois do parted) só limpa dentro dos
		# limites das partições NOVAS. Se o disco veio de um layout anterior
		# diferente (ex.: MBR_BIOS trocado por GPT_BIOS/EFI), sinais de
		# filesystem das partições ANTIGAS que caem fora dessas novas
		# fronteiras nunca são tocados — ficam enroscados no disco. Zera o
		# disco inteiro antes de escrever a tabela nova.
		wipefs -a "${AConfDisk[_DEVICE]}" >/dev/null 2>&1

		parted --align=opt --script "${AConfDisk[_DEVICE]}" -- "$CSCRIPT" 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER
		evaluate_retval "${PIPESTATUS[0]}"
		parted --align=opt --script "${AConfDisk[_DEVICE]}" -- print 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER
		sync 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER
		partprobe 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER

		# Limpa qualquer assinatura antiga (LUKS, ext4, etc.) que possa ter
		# ficado gravada na mesma região de disco de uma partição anterior,
		# já que mklabel recria só a tabela, não o conteúdo das partições.
		for _p in "${!Amntpoint[@]}"; do
			wipefs -a "$_p" >/dev/null 2>&1
		done

		Amkfs+=(["vfat"]="mkfs.vfat")
		Amkfs+=(["swap"]="mkswap")
		Amkfs+=(["ext4"]="mkfs.ext4")
		LMKPARTED=true
		LMKPARTED_DEVICE="${AConfDisk[_DEVICE]}"
		LFS=true
		LPARTITION=true
		LFSREVISED=true
		# sh_check_disk_health "${AConfDisk[_DEVICE]}"
	else
		die "${cmsg_InstalacaoAbortada}..."
	fi
}

