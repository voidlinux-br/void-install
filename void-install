unfmt() {
	local last_msg="$*"
	logmessage="${last_msg/${bold}${yellow}/}"
	logmessage="${logmessage/${reset}/}"
	echo "$logmessage"
}

log_info_msg() {
	last_msg="$*"

	if ! ((quiet)); then
		echo -n -e "${BMPREFIX}${*}"
	fi
	return 0
}

log_info_msg_level() {
	last_msg="$*"

	if ! ((quiet)); then
		echo -n -e "   ${BMPREFIX}${*}"
	fi
	return 0
}

log_error() {
