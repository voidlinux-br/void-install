# Nome da sessão gravado no autologin do DM (sddm/gdm/lxdm/lightdm).
# Mapa chave→sessão: o .desktop nem sempre usa o nome do WM (lxde → LXDE).
# Sessões vêm de /usr/share/{xsessions,wayland-sessions}.
# tty/server/xorg ficam de fora: não têm sessão, e nesses casos
# _DISPLAYMANAGER="None" e o valor nem é lido.
sh_get_session_name() {
	local SESSION_NAME=xfce
	local x
	local -A aSession=(
		[bspwm]=bspwm
		[cinnamon]=cinnamon
		[enlightenment]=enlightenment
		[fluxbox]=fluxbox
		[gnome]=gnome
		[hyprland]=hyprland
		[i3]=i3
		[lxde]=LXDE
		[mango]=mango
		[mate]=mate
		[plasma]=plasma
		[river]=river
		[sway]=sway
		[xfce]=xfce
	)

	for x in "${_WINDOWMANAGER[@]}"; do
		# subscrito vazio é "bad array subscript" em array associativo
		[[ -n "$x" ]] || continue

		# 'local' = marcador de ISO/squashfs; sessão vem do os-release do live
		if [[ "$x" = "local" ]]; then
			SESSION_NAME="$(sh_get_edition)"
			SESSION_NAME="${SESSION_NAME,,}"
			break
		fi
		if [[ -n "${aSession[$x]}" ]]; then
			SESSION_NAME="${aSession[$x]}"
			break
		fi
	done
	echo "$SESSION_NAME"
}

