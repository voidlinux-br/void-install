# Configuração de boot com LUKS comum a qualquer bootloader (GRUB ou Limine):
# grava /etc/crypttab e, opcionalmente, cria uma chave de desbloqueio
# automático embutida na initramfs. Cada bootloader, depois de chamar esta
# função, só precisa escrever o cmdline no seu próprio formato.
#
# $1 (usekeyfile, default "true"): se "true", cria /boot/volume.key e
# configura o crypttab pra abrir sozinho, sem pedir senha na initramfs — só
# faz sentido quando /boot fica DENTRO do container (GRUB com cryptodisk),
# já que aí a senha real já foi pedida antes, pelo próprio bootloader, pra
# ler o /boot. Se "false" (caso do Limine, onde /boot fica FORA do LUKS, numa
# partição sem proteção nenhuma), a chave NÃO é criada — deixá-la ali seria
# guardar a chave da porta bem ao lado da porta. Sem keyfile, o crypttab usa
# "none" e o dracut pede a senha de verdade na initramfs, que é o esperado.
sh_confLuksBoot() {
	local usekeyfile="${1:-true}"
	local xuuidfde

	xuuidfde=$(blkid -o value -s UUID "${AConfFde[partition]}")
	AConfFde[uuid]="$xuuidfde"

	if [[ "$usekeyfile" == "true" ]]; then
		sh_chroot_job "Criando chave aleatória" "dd bs=1 count=64 if=/dev/urandom of=/boot/volume.key"
		sh_chroot_job "Adicionando a chave ao volume cryptografado" "printf ${AConfFde[passphrase]} | cryptsetup luksAddKey ${AConfFde[partition]} /boot/volume.key --key-file=-"
		sh_chroot_job "Alterando permissões para proteger a chave" "chmod 000 /boot/volume.key; chmod -R g-rwx,o-rwx /boot"
		echo "${AConfFde[vg]}	UUID=$xuuidfde	/boot/volume.key	luks" >>"$dir_install/etc/crypttab"
		echo 'install_items+=" /boot/volume.key /etc/crypttab "' >>"$dir_install/etc/dracut.conf.d/10-crypt.conf"
	else
		echo "${AConfFde[vg]}	UUID=$xuuidfde	none	luks" >>"$dir_install/etc/crypttab"
	fi
}

sh_set_edition_os_release() {
	local name="$1"
	local f="${dir_install}/etc/os-release"

	sh_info_msg "${cmsg_Ajustando} $f"
	[[ -f "$f" ]] || return 1
	name="${name^}"
	if grep -q '^EDITION=' "$f"; then
		sed -i "s/^EDITION=.*/EDITION=\"$name\"/" "$f"
	else
		[[ -s "$f" ]] && [[ -n "$(tail -c1 "$f")" ]] && echo >>"$f"
		echo "EDITION=\"$name\"" >>"$f"
	fi
}

# Nome CRU da edição. Alimenta o SESSION_NAME do DM, por isso não normaliza
# nada — 'tty' aqui tem que continuar 'tty'. Pra nome de exibição (bootloader,
# os-release), use sh_get_edition_label.
sh_get_edition() {
	local distro_name

	if [[ "${AConfMirror[_SOURCE]}" = "local" ]]; then
		# EDITION do live: o squashfs é o que vai pro alvo, então a edição da
		# ISO é a edição instalada. Aspas são opcionais e só a 1a linha conta.
		distro_name=$(sed -n 's/^EDITION=//p' /etc/os-release | head -n1 | tr -d "\"'")
	fi

	# Sem fallback, um os-release sem EDITION devolveria string vazia e ela
	# vazaria silenciosamente pro GRUB_DISTRIBUTOR, pro os-release do alvo e
	# pro SESSION_NAME.
	[[ -n "$distro_name" ]] || distro_name="$_WM"
	[[ -n "$distro_name" ]] || distro_name="tty"

	echo "${distro_name^}"
}

# Nome de EXIBIÇÃO da edição (GRUB, Limine e os-release do alvo). Único lugar
# onde 'tty' vira 'Base' — antes essa conversão estava duplicada dentro de
# sh_change_grub e sh_change_limine e faltava na gravação do os-release, o que
# deixava o menu de boot em "VoidBR Base" e o os-release em EDITION="Tty".
sh_get_edition_label() {
	local distro_name

	distro_name="$(sh_get_edition)"
	[[ "${distro_name,,}" = tty ]] && distro_name="Base"
	echo "${distro_name^}"
}

sh_change_grub() {
	local f="${dir_install}/etc/default/grub"
	local distro_name="$(sh_get_edition_label)"

	sh_cmd_job "$(gettext 'Aplicando ajustes no GRUB')" "
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=\"VoidBR ${distro_name}\"/' '$f'
  " "$err_not_fatal"
}

sh_change_limine() {
	local f="${dir_install}/etc/default/limine"
	local distro_name="$(sh_get_edition_label)"

	sh_cmd_job "$(gettext 'Aplicando ajustes no Limine')" "
    touch '$f'
    if grep -q '^LIMINE_DISTRO_NAME=' '$f'; then
      sed -i 's/^LIMINE_DISTRO_NAME=.*/LIMINE_DISTRO_NAME=\"VoidBR ${distro_name}\"/' '$f'
    else
      [ -s '$f' ] && [ -n \"\$(tail -c1 '$f')\" ] && echo >>'$f'
      echo 'LIMINE_DISTRO_NAME=\"VoidBR ${distro_name}\"' >>'$f'
    fi
  " "$err_not_fatal"
}

sh_grubInstall() {
	local cfile="$dir_install/etc/default/grub"
	local xuuidfde

	cat >$cfile <<EOF
#
# Configuration file for GRUB.
#
GRUB_DEFAULT=0
#GRUB_HIDDEN_TIMEOUT=0
#GRUB_HIDDEN_TIMEOUT_QUIET=false
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="VoidBR"
# Uncomment to use basic console
#GRUB_TERMINAL_INPUT="console"
# Uncomment to disable graphical terminal
#GRUB_TERMINAL_OUTPUT=console
#GRUB_BACKGROUND=/usr/share/void-artwork/splash.png
#GRUB_GFXMODE=1920x1080x32
#GRUB_DISABLE_LINUX_UUID=true
#GRUB_DISABLE_RECOVERY=true
# Uncomment and set to the desired menu colors.  Used by normal and wallpaper
# modes only.  Entries specified as foreground/background.
#GRUB_COLOR_NORMAL="light-blue/black"
#GRUB_COLOR_HIGHLIGHT="light-cyan/blue"
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet splash"
GRUB_THEME="/boot/grub/themes/voidbr/theme.txt"
EOF

	if $LOSPROBER; then
		echo "GRUB_DISABLE_OS_PROBER=false" >>"$dir_install/etc/default/grub"
	else
		echo "GRUB_DISABLE_OS_PROBER=true" >>"$dir_install/etc/default/grub"
	fi

	if $LFDE; then
		sh_confLuksBoot
		sh_chroot_job "Alterando /etc/default/grub" "
		  sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=/#&/' /etc/default/grub
    "

		{
			echo "GRUB_CMDLINE_LINUX_DEFAULT='splash quiet udev.log_priority=3 libata.noacpi=1 loglevel=4 rd.luks.allow-discards rd.lvm.vg=${AConfFde[vg]} rd.luks.uuid=${AConfFde[uuid]}'"
			echo "GRUB_ENABLE_CRYPTODISK=y"
		} >>"$dir_install/etc/default/grub"

		# Mesmo motivo do Limine: garantir que a initramfs já tenha suporte a
		# crypt/lvm agora, sem depender de um hook posterior (xbps-reconfigure)
		# rodar de fato. O GRUB lê /boot ao vivo, então isso é suficiente aqui
		# (diferente do Limine, que precisa da cópia feita por update-limine).
		sh_chroot_job "Regenerando initramfs com suporte a LUKS/LVM" "
		  dracut --force --regenerate-all
    "
	fi

	sh_cmd_job "${cmsg_Ajustando} /etc/grub.d/" "
    rm -f ${dir_install}/etc/grub.d/*new* || true
  "

	if $LBIOS; then
		# Checagem defensiva: numa instalação 100% local (sem rede), os
		# módulos do GRUB só existem se já vieram no squashfs do live. Se
		# faltar, o grub-install falha com um erro críptico ("modinfo.sh
		# doesn't exist") — melhor avisar com clareza o motivo real.
		if [[ -d "$dir_install/usr/lib/grub/i386-pc" || -d "$dir_install/usr/lib64/grub/i386-pc" ]]; then
			sh_chroot_job "${cmsg_Instalando} GRUB $(gettext 'para a plataforma') i386-pc" "
        grub-install ${AConfDisk[_BOOTLOADER]} --target=i386-pc --force
		  "
		else
			die "$(gettext 'Módulos do GRUB (i386-pc) não encontrados no sistema.') $(gettext 'O pacote correspondente não veio no sistema live usado nesta instalação 100% local, e a atualização pela internet não foi liberada.') $(gettext 'Refaça a instalação permitindo atualizar pela internet, ou use uma ISO que já inclua esse pacote.')"
		fi
	fi

	if $LEFI; then
		# --removable   = garante boot universal via Fallback
		# --no-nvram    = não mexe na BIOS
		if [[ -d "$dir_install/usr/lib/grub/$TARGET_EFI" || -d "$dir_install/usr/lib64/grub/$TARGET_EFI" ]]; then
			sh_chroot_job "${cmsg_Instalando} GRUB $(gettext 'para a plataforma') x86_64-efi" "
			   grub-install ${AConfDisk[_BOOTLOADER]} --target=$TARGET_EFI --efi-directory=/boot/efi --boot-directory=/boot --bootloader-id=$cnickefi --removable --no-nvram
		   "
			#		sh_mkefiroaming
		else
			die "$(gettext 'Módulos do GRUB') ($TARGET_EFI) $(gettext 'não encontrados no sistema.') $(gettext 'O pacote grub-x86_64-efi não veio no sistema live usado nesta instalação 100% local, e a atualização pela internet não foi liberada. Sem ele, o boot EFI não pode ser configurado.') $(gettext 'Refaça a instalação permitindo atualizar pela internet, ou use uma ISO que já inclua esse pacote.')"
		fi
	fi

	sh_change_grub

	# Antes só rodava "if ! $LVM" — mas LFDE sempre implica LVM=true, então
	# o grub.cfg nunca era gerado aqui em instalações com LUKS, ficando
	# dependente só de um hook posterior (xbps-reconfigure) rodar por conta
	# própria. Gerar sempre aqui é seguro e idempotente.
	sh_chroot_job "${cmsg_Gerando} grub.cfg" "
		   grub-mkconfig -o /boot/grub/grub.cfg
	   "
}

sh_limineInstall() {
	if $LFDE; then
		sh_confLuksBoot false
		# update-limine.sh lê /etc/default/limine (LIMINE_CMDLINE_LINUX_DEFAULT) e
		# embute isso no cmdline de cada entrada gerada, junto do root=UUID que
		# ele mesmo descobre via findmnt. Sem isso, a initramfs nunca saberia
		# qual container destrancar. Sobrevive a updates futuros de kernel,
		# já que update-limine relê esse arquivo toda vez que roda.
		sh_chroot_job "Alterando /etc/default/limine" "
		  sed -i 's/^LIMINE_CMDLINE_LINUX_DEFAULT=/#&/' /etc/default/limine 2>/dev/null || true
    "
		echo "LIMINE_CMDLINE_LINUX_DEFAULT=\"rw loglevel=4 rd.luks.allow-discards rd.lvm.vg=${AConfFde[vg]} rd.luks.uuid=${AConfFde[uuid]}\"" >>"$dir_install/etc/default/limine"

		# CRÍTICO: update-limine só COPIA a initramfs que já existe em /boot para
		# o ESP — ele não gera nada. A initramfs original foi criada na instalação
		# do kernel, ANTES de /etc/crypttab existir, então não tem os módulos de
		# crypt/lvm embutidos. Sem regenerar agora, o update-limine copiaria essa
		# initramfs "cega" pro LUKS, e o sistema abriria sem pedir senha nenhuma
		# (na real, ele simplesmente não teria como montar o root criptografado).
		sh_chroot_job "Regenerando initramfs com suporte a LUKS/LVM" "dracut --force --regenerate-all"
	fi

	if [[ -f "$dir_install/usr/share/limine/BOOTX64.EFI" && -f "$dir_install/usr/share/limine/limine-bios.sys" ]]; then
		sh_chroot_job "${cmsg_Instalando} Limine $(gettext 'para a plataforma') x86_64-efi" "
      mkdir -p /boot/efi/EFI/BOOT
      mkdir -p /boot/efi/EFI/limine
      mkdir -p /boot/efi/limine
      cp -a /usr/share/limine/BOOTX64.EFI /boot/efi/EFI/BOOT/
      cp -a /usr/share/limine/BOOTX64.EFI /boot/efi/EFI/limine/
      cp -a /usr/share/limine/limine-bios.sys /boot/efi/limine/
      rm -rf /boot/EFI
    "
	else
		die "$(gettext 'Arquivos do Limine não encontrados no sistema.') $(gettext 'O pacote limine não veio no sistema live usado nesta instalação 100% local, e a atualização pela internet não foi liberada.') $(gettext 'Refaça a instalação permitindo atualizar pela internet, ou use uma ISO que já inclua esse pacote.')"
	fi

	if $LBIOS; then
		sh_chroot_job "${cmsg_Instalando} Limine $(gettext 'para a plataforma') i386-pc" "
      limine bios-install ${AConfDisk[_BOOTLOADER]} 1 --force
	   "
	fi

	if $LEFI; then
		# Testes repetidos acumulam entradas "Limine" antigas no NVRAM, apontando
		# pra GUIDs de disco que não existem mais (cada reparticionamento gera um
		# GUID novo). O firmware pode acabar bootando uma dessas entradas velhas
		# em vez da instalação atual — sintoma: boot não pede senha do LUKS,
		# porque na real é outro sistema (mais antigo) sendo bootado por engano.
		# Isso vale tanto rodando direto quanto dentro de QEMU/OVMF, já que o
		# efivarfs do sistema live reflete no mesmo arquivo de NVRAM persistente.
		sh_chroot_job "Limpando entradas Limine antigas do NVRAM" "
      for bootnum in \$(efibootmgr 2>/dev/null | awk -F'Boot|[* ]' '/Limine/{print \$2}'); do
        efibootmgr -b \"\$bootnum\" -B >/dev/null 2>&1
      done
      true
    "

		if ! sh_is_running_hypervisor; then
			sh_chroot_job "${cmsg_Instalando} Limine $(gettext 'para a plataforma') x86_64-efi" "
        efibootmgr -c \
          -d ${AConfDisk[_BOOTLOADER]} \
          -p 2 \
          -L 'Limine' \
          -l '\EFI\limine\BOOTX64.EFI'
    	"
		else
			local vm_user vm_home vm_vars

			vm_user="${SUDO_USER:-$(id -un)}"
			vm_home=$(getent passwd "$vm_user" | cut -d: -f6)
			vm_vars="$vm_home/.chili-fr/OVMF_VARS.4m.fd"

			if ! hash virt-fw-vars 2>/dev/null; then
				sh_info_msg "${RED} ✗ ${RST} virt-fw-vars $(gettext 'não encontrado') — $(gettext 'entrada de boot não registrada na VM')"
			elif [[ ! -f "$vm_vars" ]]; then
				sh_info_msg "${RED} ✗ ${RST} ${vm_vars} $(gettext 'não encontrado') — $(gettext 'entrada de boot não registrada na VM')"
			else
				virt-fw-vars \
					--inplace "$vm_vars" \
					--append-boot-filepath "$dir_install/boot/efi/EFI/limine/BOOTX64.EFI" 2>&1 |
					tee -i -a "$BOOTLOG" >"$LOGGER"
				((PIPESTATUS[0] == 0)) || sh_info_msg "${RED} ✗ ${RST} virt-fw-vars $(gettext 'falhou') — $(gettext 'entrada de boot não registrada na VM')"
			fi
		fi
	fi

	sh_change_limine

	sh_chroot_job "${cmsg_Instalando} Limine $(gettext 'para a plataforma') x86_64-efi" "
    update-limine || true
  "

}

