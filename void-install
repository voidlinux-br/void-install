sh_run_binary() {
	local binary="${1}"
	local lang="${2}"
	local grafic="${3}"

	if [[ -n $(command -v "${binary}") || -n $(command -v ./"${binary}") ]]; then
		bash "${binary}" "$lang" "${grafic}"
		return 0
	fi

	msg "INFO" "$(log_info_msg "$(gettext "Aguarde...") ${cmsg_Gerando} test with "${binary}" ${xurl}")"
	evaluate_retval 1 "$err_not_fatal"
	info "=== ${binary} ===" \
		"\n${RED}✗ $(gettext "binário não foi localizado no") ${YELLOW}\$PATH${RESET}" \
		"${RED}✗ $(gettext "binário não foi localizado na pasta local:") ${YELLOW}$PWD${RESET}" \
		"${YELLOW}\n➡ $(gettext "DICA: instale o pacote voidbr-utils")"
	return 1
