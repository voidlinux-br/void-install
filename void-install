sh_getmntpoint() {
	local str
	local nlen=13
	local sep="\xe2\x94\x82"

	str+="\
$(printf "%-${nlen}s" PARTITION)	\
$(printf "$sep%-${nlen}s" FSTYPE)	\
$(printf "$sep%-${nlen}s" SIZE)	\
$(printf "$sep%-${nlen}s" LABEL)	\
$(printf "$sep%-${nlen}s" MOUNTPOINT)	\
$(printf "$sep%-${nlen}s" NEWFSTYPE)	\
