	local model
	local chostname
	local usertext
	local exit_status
	local -a aUser

	# O hostname automático acompanha a edição: sem isto, preencher a tela
	# Extra antes de escolher o WM congela 'voidbr-base' (LEXTRA=true trava o
	# recálculo). Nome digitado pelo usuário é preservado — só o que casa com
