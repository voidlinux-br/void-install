# Constrói o mapa completo (todo dispositivo, sem filtro) de tipo e pai —
# usado por sh_is_nested_lvm pra descobrir se uma LV está aninhada dentro
# de outra (ex: uma LV que mora numa partição que por sua vez é parte de
# outra LV — resultado de instalação anterior em cascata).
declare -gA _kname_type=()
declare -gA _kname_pkname=()
sh_populate_nested_lvm_map() {
	local _kn _tp _pk
	_kname_type=()
	_kname_pkname=()
	while IFS= read -r line; do
		unset _kn _tp _pk
		eval "$line"
		_kname_type["$_kn"]="$_tp"
		_kname_pkname["$_kn"]="$_pk"
	done < <(lsblk -Po KNAME,TYPE,PKNAME | sed -E 's/KNAME=/_kn=/; s/TYPE=/_tp=/; s/PKNAME=/_pk=/')
}

# Sobe a cadeia de pais (até 6 níveis) procurando o padrão específico:
# LV cujo pai é uma PARTIÇÃO, e essa partição pertence a OUTRA LV — isso
# sim é aninhamento de instalação anterior (ex: voidbrvm-root dentro de
# uma partição de pve-lvm). Não confundir com LV sendo filha direta de
# outra LV (ex: pool thin) — isso é arquitetura normal do LVM, comum a
# praticamente toda LV do sistema, não deve ser filtrado.
#
# ATENÇÃO — bug real já cometido aqui: uma primeira versão marcava como
# "aninhado" qualquer LV com UM ancestral LVM em qualquer nível acima,
# sem checar se havia uma partição no meio. Isso filtrava incorretamente
# TODAS as LVs de um mesmo pool thin (ex: pve-lvm, pve-evili,
# pve-voidbr--*), já que elas compartilham o mesmo pool (dm-2) como
# ancestral — sumindo com discos válidos da lista. A checagem precisa
# ser exatamente "pai é partição E avô é LV", não "algum ancestral é LV".
#
# Outro bug real já cometido: essa lógica ficou presa dentro de
# sh_disk_info, que não é chamada em lugar nenhum (código morto) — a
# tela de escolha de disco de verdade usa sh_disk_part_info. Por isso
# virou função independente, reaproveitável pelas duas.
sh_is_nested_lvm() {
	local kname="$1"
	local parent="${_kname_pkname[$kname]}"
	local grandparent
	local depth=0
	while [[ -n "$parent" && $depth -lt 6 ]]; do
		if [[ "${_kname_type[$parent]}" = "part" ]]; then
			grandparent="${_kname_pkname[$parent]}"
			[[ "${_kname_type[$grandparent]}" = "lvm" ]] && return 0
		fi
		parent="${_kname_pkname[$parent]}"
		((depth++))
	done
	return 1
}

sh_disk_part_info() {
	unset ARRAY_DSK_{DISKS,DEVICES,SIZE,TRAN,MODEL,LABEL,SERIAL,PTTYPE,FSTYPE}
	unset ARRAY_PART_{DISKS,DEVICES,SIZE,TRAN,MODEL,LABEL,SERIAL,FSTYPE,PARTTYPENAME}
	local {NAME,PATH,SIZE,TRAN,MODEL,LABEL,SERIAL,PTTYPE,FSTYPE,PARTTYPENAME,KNAME}_

	mensagem "$(gettext "=== DISCO/PARTIÇÃO ===")" "\n\n${BOLD}${WHITE}$(gettext "Aguarde... coletando informações")"
	AARRAY_DSK_DEVICES=()
	AARRAY_PART_DEVICES=()
	sh_populate_nested_lvm_map
	while read -r line; do
		eval "${line//=/_=}"
		if [[ "${TYPE_}" != "part" ]]; then
			# Uma LV que mora dentro de uma partição de outra LV é resultado de
			# instalação anterior em cascata, não um disco de verdade pra
			# oferecer como opção aqui (ver sh_is_nested_lvm acima).
			[[ "${TYPE_}" = "lvm" ]] && sh_is_nested_lvm "$KNAME_" && continue

			ARRAY_DSK_DISKS+=("$NAME_")
			ARRAY_DSK_DEVICES+=("$PATH_")
			ARRAY_DSK_SIZE+=("$SIZE_")
			ARRAY_DSK_TRAN+=("${TRAN_:-${TYPE_}}")
			ARRAY_DSK_MODEL+=("${MODEL_:-${TYPE_} device}")
			ARRAY_DSK_LABEL+=("${LABEL_:-""}")
			ARRAY_DSK_SERIAL+=("${SERIAL_:-""}")
			ARRAY_DSK_PTTYPE+=("${PTTYPE_:-""}")
			ARRAY_DSK_FSTYPE+=("${FSTYPE_:-none}")
			ARRAY_DSK_PARTTYPENAME+=("${PARTTYPENAME_:-none}")
			AARRAY_DSK_DEVICES+=(["$PATH_"]="$NAME_|$SIZE_|${TRAN_:-${TYPE_}}|${MODEL_:-unknown}|${LABEL_:-""}|${SERIAL_:-""}|${PTTYPE_:-""}|${FSTYPE_:-"none"}|${PARTTYPENAME_:-none}")
		fi
		if [[ "${TYPE_}" = "part" ]]; then
			[[ "$FSTYPE_" = "iso9660" ]] && continue
			# Nunca oferecer uma partição LUKS existente como opção de
			# mountpoint manual (não é reaproveitável, ver sh_has_luks_remnant).
			[[ "$FSTYPE_" = "crypto_LUKS" ]] && continue
			#		[[ "$FSTYPE_"  = "LVM2_member" ]] && continue
			ARRAY_PART_DISKS+=("$NAME_")
			ARRAY_PART_DEVICES+=("$PATH_")
			ARRAY_PART_SIZE+=("$SIZE_")
			ARRAY_PART_TRAN+=("${TRAN_:-${TYPE_}}")
			ARRAY_PART_MODEL+=("${MODEL_:-unknown}")
			ARRAY_PART_LABEL+=("${LABEL_:-""}")
			ARRAY_PART_SERIAL+=("${SERIAL_:-""}")
			ARRAY_PART_FSTYPE+=("${FSTYPE_:-none}")
			ARRAY_PART_PARTTYPENAME+=("${PARTTYPENAME_:-none}")
			AARRAY_PART_DEVICES+=(["$PATH_"]="$NAME_|$SIZE_|${TRAN_:-${TYPE_}}|${MODEL_:-unknown}|${LABEL_:-""}|${SERIAL_:-""}|${FSTYPE_:-"none"}|${PARTTYPENAME_:-none}")
		fi
	done < <(lsblk -PAo TYPE,NAME,PATH,SIZE,TRAN,MODEL,LABEL,SERIAL,PTTYPE,FSTYPE,PARTTYPENAME,KNAME |
		grep -P 'TYPE="(disk|loop|lvm|part)"' |
		grep -Pv 'NAME=".*(_tdata|-data|_tmeta|-tpool)"' |
		sort -u -t'"' -k6,6)
	#  	done < <(lsblk -PAo TYPE,NAME,PATH,SIZE,TRAN,MODEL,LABEL,SERIAL,PTTYPE,FSTYPE,PARTTYPENAME | grep -P 'TYPE="(disk|loop|lvm|part)"' | sort -k5,5 -k2,2)
}

sh_part_info() {
	unset ARRAY_PART_{DISKS,DEVICES,SIZE,TRAN,MODEL,LABEL,SERIAL,FSTYPE,PARTTYPENAME}
	local {NAME,PATH,SIZE,TRAN,MODEL,LABEL,SERIAL,FSTYPE,PARTTYPENAME}_

	mensagem "$(gettext "=== PARTIÇÃO ===")" "\n\n${BOLD}${WHITE}$(gettext "Aguarde... coletando informações")"
	AARRAY_PART_DEVICES=()
	while read -r line; do
		eval "${line//=/_=}"
		[[ "$FSTYPE_" = "iso9660" ]] && continue
		# Mesmo motivo de sh_disk_part_info: LUKS existente não é opção válida.
		[[ "$FSTYPE_" = "crypto_LUKS" ]] && continue
		[[ "$FSTYPE_" = "LVM2_member" ]] && continue
		ARRAY_PART_DISKS+=("$NAME_")
		ARRAY_PART_DEVICES+=("$PATH_")
		ARRAY_PART_SIZE+=("$SIZE_")
		ARRAY_PART_TRAN+=("${TRAN_:-${TYPE_}}")
		ARRAY_PART_MODEL+=("${MODEL_:-unknown}")
		ARRAY_PART_LABEL+=("${LABEL_:-""}")
		ARRAY_PART_SERIAL+=("${SERIAL_:-""}")
		ARRAY_PART_FSTYPE+=("${FSTYPE_:-none}")
		ARRAY_PART_PARTTYPENAME+=("${PARTTYPENAME_:-none}")
		AARRAY_PART_DEVICES+=(["$PATH_"]="$NAME_|$SIZE_|${TRAN_:-${TYPE_}}|${MODEL_:-unknown}|${LABEL_:-""}|${SERIAL_:-""}|${FSTYPE_:-"none"}|${PARTTYPENAME_:-none}")
	done < <(
		lsblk -PAo TYPE,NAME,PATH,SIZE,TRAN,MODEL,LABEL,SERIAL,PTTYPE |
			grep -P 'TYPE="(part)"' |
			grep -Pv 'NAME=".*(_tdata|_tmeta|-tpool)"' |
			awk -F'"' '!seen[$6]++'
	)
	#	done < <(lsblk -fPAo TYPE,NAME,PATH,SIZE,TRAN,MODEL,LABEL,SERIAL,FSTYPE,PARTTYPENAME | grep -P 'TYPE="(part)"' | sort -k5,5 -k2,2)
}

sh_check_disk_health() {
	local disk="$1"
	local msg

	AConfDisk[_HEALTH]="$disk"
	[[ -b "$disk" ]] || {
		if [[ -z "$1" ]]; then
			msg="\n${BOLD}${RED}$(gettext 'Necessário escolher um dispositivo para TESTAR')${RESET}"
		else
			msg="\n${BOLD}${RED}$(gettext 'Dispositivo inválido'): ${CYAN}${disk}${RESET}"
		fi
		if conf "=== ERRO ===" \
			"${msg}\n\n${YELLOW}$(gettext 'Deseja escolher agora?')"; then
			if ! sh_choose_disk "${cmsg_DiskHealth}"; then
				return 1
			fi

			disk="${AConfDisk[_HEALTH]}"
		else
			return 2
		fi
	}

	sh_info_msg "$(gettext 'Testando saude do disco'): ${CYAN}${disk}${RESET}"

	local model serial size tran pttype=""
	# Dois status independentes em vez de um único: ESTRUTURA (tabela de
	# partição, GPT/MBR, blkid, wipefs) e HARDWARE (SMART, dmesg). Um
	# disco novo/zerado (sem tabela) é aviso de ESTRUTURA, nunca defeito
	# de HARDWARE — só SMART e dmesg indicam problema físico real. O
	# valor retornado pela função continua sendo o maior dos dois, para
	# preservar o contrato 0=ok/1=aviso/2=crítico já usado pelos
	# chamadores desta função.
	local st_estrutura=0 st_hardware=0
	local report=""
	local errors=""
	local smart="Não disponível"

	model=$(lsblk -dn -o MODEL "$disk" 2>/dev/null | xargs)
	serial=$(lsblk -dn -o SERIAL "$disk" 2>/dev/null | xargs)
	size=$(lsblk -dn -o SIZE "$disk" 2>/dev/null | xargs)
	tran=$(lsblk -dn -o TRAN "$disk" 2>/dev/null | xargs)
	pttype=$(lsblk -dn -o PTTYPE "$disk" 2>/dev/null | xargs)

	report+="Disco.............: ${CYAN}$disk${RESET}\n"
	report+="Modelo............: ${CYAN}${model:-Desconhecido}${RESET}\n"
	report+="Serial............: ${CYAN}${serial:-N/A}${RESET}\n"
	report+="Tamanho...........: ${CYAN}$size${RESET}\n"
	report+="Interface.........: ${CYAN}${tran:-N/A}${RESET}\n\n"

	# --------------------------------------------------------
	# Tabela de Partições (GPT / MBR / DOS)   [categoria: ESTRUTURA]
	# --------------------------------------------------------
	# LC_ALL=C força a saída do fdisk em inglês independente do locale
	# do sistema. O grep antigo procurava "Tipo de rótulo do disco: ..."
	# (pt_BR), mas o fdisk só imprime nesse idioma se o SISTEMA (não só
	# este script) estiver de fato em locale pt_BR instalado — em
	# qualquer outro caso (padrão de live-CD/ISO de instalação, que
	# tipicamente roda em locale C/POSIX) o grep nunca batia, e um disco
	# GPT/MBR perfeitamente saudável caía no "else" como "Não detectada"
	# -> status crítico (falso defeito).
	if [[ -z "$pttype" ]]; then
		if LC_ALL=C fdisk -l "$disk" 2>/dev/null | grep -qi "Disklabel type: gpt"; then
			pttype="gpt"
			report+="Tabela............: ${YELLOW}GPT (lsblk não detectou)${RESET}\n"
			report+="Aviso.............: ${YELLOW}libblkid falhou ao detectar GPT; usado fallback via fdisk.${RESET}\n"
			((st_estrutura < 1)) && st_estrutura=1
		elif LC_ALL=C fdisk -l "$disk" 2>/dev/null | grep -qi "Disklabel type: dos"; then
			pttype="dos"
			report+="Tabela............: ${GREEN}DOS/MBR${RESET}\n"
		else
			# Disco sem tabela nenhuma (novo ou recém-zerado) é um
			# ESTADO, não um defeito de hardware — não deve subir a
			# status crítico.
			report+="Tabela............: ${YELLOW}Não detectada (disco sem partições?)${RESET}\n"
			((st_estrutura < 1)) && st_estrutura=1
		fi
	else
		report+="Tabela............: ${GREEN}${pttype^^}${RESET}\n"
	fi

	# --------------------------------------------------------
	# Validação de Headers (GPT vs MBR/DOS)   [categoria: ESTRUTURA]
	# --------------------------------------------------------
	# Antes, o teste de assinatura GPT rodava incondicionalmente mesmo
	# em disco MBR saudável (a busca por "EFI PART" sempre falhava nesse
	# caso, marcando um disco perfeito como defeituoso). Agora só roda
	# se a tabela for GPT, e o MBR ganha uma checagem própria e real
	# (0x55AA), em vez de nenhuma verificação.
	case "${pttype,,}" in
	gpt)
		# Tamanho de setor lógico real via blockdev --getss (não fixo
		# em 512), para não dar falso-negativo em discos 4Kn. blockdev
		# --getsz sempre devolve em unidades de 512 bytes, por isso a
		# conversão para o número de setores lógicos antes de calcular
		# o offset do backup. A comparação "EFI PART" via head -c 8
		# elimina a dependência de "strings" (binutils, que não estava
		# nem em DEPENDENCIES): se ausente, os dois testes falhavam e
		# o disco virava "defeituoso" sem motivo real.
		local ss sectors512 logical_sectors sig
		ss=$(blockdev --getss "$disk" 2>/dev/null)
		ss="${ss:-512}"
		sectors512=$(blockdev --getsz "$disk" 2>/dev/null)
		logical_sectors=$((sectors512 * 512 / ss))

		sig=$(dd if="$disk" bs="$ss" skip=1 count=1 status=none 2>/dev/null | head -c 8)
		if [[ "$sig" == "EFI PART" ]]; then
			report+="GPT Primária......: ${GREEN}OK${RESET}\n"
		else
			report+="GPT Primária......: ${RED}FALHOU${RESET}\n"
			st_estrutura=2
		fi

		if ((logical_sectors > 0)); then
			sig=$(dd if="$disk" bs="$ss" skip=$((logical_sectors - 1)) count=1 status=none 2>/dev/null | head -c 8)
			if [[ "$sig" == "EFI PART" ]]; then
				report+="GPT Backup........: ${GREEN}OK${RESET}\n"
			else
				report+="GPT Backup........: ${RED}FALHOU${RESET}\n"
				((st_estrutura < 2)) && st_estrutura=1
			fi
		fi
		;;
	dos | mbr)
		local mbr_sig
		mbr_sig=$(dd if="$disk" bs=1 skip=510 count=2 status=none 2>/dev/null | od -An -tx1 | tr -d ' \n')
		if [[ "$mbr_sig" == "55aa" ]]; then
			report+="Assinatura MBR....: ${GREEN}OK (0x55AA)${RESET}\n"
		else
			report+="Assinatura MBR....: ${RED}FALHOU${RESET}\n"
			st_estrutura=2
		fi
		;;
	esac

	# --------------------------------------------------------
	# blkid — rc=2 significa "sem assinatura" (disco vazio), não é erro.
	# Só rc>2 é falha de verdade. LC_ALL=C evita o mesmo problema de
	# locale do fdisk acima, já que "Permission denied" também é
	# traduzido pela glibc via LC_MESSAGES quando o pacote de locale
	# está instalado.   [categoria: ESTRUTURA]
	# --------------------------------------------------------
	local blkid_rc blkid_err
	blkid_err=$(LC_ALL=C blkid -p "$disk" 2>&1 >/dev/null)
	blkid_rc=$?
	case "$blkid_rc" in
	0) report+="blkid.............: ${GREEN}OK${RESET}\n" ;;
	2) report+="blkid.............: ${GREEN}Sem assinatura detectada${RESET}\n" ;;
	*)
		if grep -qiE "permission denied|operation not permitted" <<<"$blkid_err"; then
			report+="blkid.............: ${YELLOW}Sem permissão para verificar (ambiente restrito?)${RESET}\n"
		else
			report+="blkid.............: ${RED}FALHOU (rc=$blkid_rc)${RESET}\n"
		fi
		((st_estrutura < 1)) && st_estrutura=1
		;;
	esac

	# --------------------------------------------------------
	# wipefs -n (somente consulta; sem -a ele já não apaga nada, mas -n
	# deixa a intenção explícita no código de um instalador rodando
	# como root).   [categoria: ESTRUTURA]
	# --------------------------------------------------------
	local wipefs_err
	wipefs_err=$(LC_ALL=C wipefs -n "$disk" 2>&1 >/dev/null)
	if [[ -z "$wipefs_err" ]]; then
		report+="wipefs (consulta).: ${GREEN}OK${RESET}\n"
	else
		if grep -qiE "permission denied|operation not permitted" <<<"$wipefs_err"; then
			report+="wipefs (consulta).: ${YELLOW}Sem permissão para verificar (ambiente restrito?)${RESET}\n"
		else
			report+="wipefs (consulta).: ${RED}FALHOU${RESET}\n"
		fi
		((st_estrutura < 1)) && st_estrutura=1
	fi

	# --------------------------------------------------------
	# SMART (opcional)   [categoria: HARDWARE]
	# --------------------------------------------------------
	# Tenta detecção automática, depois -d sat e -d scsi: em muitas
	# pontes USB o smartctl sem -d não retorna nada, mesmo com o disco
	# saudável.
	if command -v smartctl >/dev/null; then
		local smart_dtype="" smart_probe
		for smart_dtype in "" "-d sat" "-d scsi"; do
			smart_probe=$(smartctl -H $smart_dtype "$disk" 2>/dev/null | awk -F: '/overall-health|SMART overall-health|SMART Health Status/ {
				gsub(/^[ \t]+/, "", $2)
				print $2
			}' | xargs)
			[[ -n "$smart_probe" ]] && {
				smart="$smart_probe"
				break
			}
		done

		[[ -z "$smart" || "$smart" == "Não disponível" ]] && smart="Indisponível (USB pode exigir -d sat)"
		report+="SMART.............: $smart\n"

		if echo "$smart" | grep -qiE 'FAILED|BAD'; then
			st_hardware=2
		fi

		if [[ "${tran,,}" == "nvme" ]]; then
			# NVMe não usa a tabela de atributos numerados do ATA/SATA
			# — os IDs abaixo simplesmente não existem nesse formato.
			# smartctl -a em NVMe imprime um log de saúde com campos
			# próprios; estes são os equivalentes mais próximos de
			# "degradação real".
			local nvme_out crit_warn pct_used media_errors avail_spare avail_thresh
			nvme_out=$(smartctl -a "$disk" 2>/dev/null)

			crit_warn=$(awk -F: '/Critical Warning/ {gsub(/^[ \t]+/,"",$2); print $2}' <<<"$nvme_out" | head -1)
			pct_used=$(awk -F: '/Percentage Used/ {gsub(/[^0-9]/,"",$2); print $2}' <<<"$nvme_out" | head -1)
			media_errors=$(awk -F: '/Media and Data Integrity Errors/ {gsub(/[^0-9]/,"",$2); print $2}' <<<"$nvme_out" | head -1)
			avail_spare=$(awk -F: '/^Available Spare:/ {gsub(/[^0-9]/,"",$2); print $2}' <<<"$nvme_out" | head -1)
			avail_thresh=$(awk -F: '/Available Spare Threshold/ {gsub(/[^0-9]/,"",$2); print $2}' <<<"$nvme_out" | head -1)

			if [[ -n "$crit_warn" ]]; then
				if [[ "$crit_warn" != "0x00" && "$crit_warn" != "0" ]]; then
					report+="  Critical Warning..........: ${RED}${crit_warn}${RESET}\n"
					st_hardware=2
				else
					report+="  Critical Warning..........: ${GREEN}${crit_warn}${RESET}\n"
				fi
			fi

			if [[ "$pct_used" =~ ^[0-9]+$ ]]; then
				if ((pct_used >= 90)); then
					report+="  Percentage Used...........: ${RED}${pct_used}%${RESET}\n"
					((st_hardware < 2)) && st_hardware=2
				elif ((pct_used >= 70)); then
					report+="  Percentage Used...........: ${YELLOW}${pct_used}%${RESET}\n"
					((st_hardware < 1)) && st_hardware=1
				else
					report+="  Percentage Used...........: ${GREEN}${pct_used}%${RESET}\n"
				fi
			fi

			if [[ "$media_errors" =~ ^[0-9]+$ ]]; then
				if [[ "$media_errors" != "0" ]]; then
					report+="  Media/Integrity Errors....: ${RED}${media_errors}${RESET}\n"
					st_hardware=2
				else
					report+="  Media/Integrity Errors....: ${GREEN}0${RESET}\n"
				fi
			fi

			if [[ "$avail_spare" =~ ^[0-9]+$ && "$avail_thresh" =~ ^[0-9]+$ ]]; then
				if ((avail_spare <= avail_thresh)); then
					report+="  Available Spare...........: ${RED}${avail_spare}% (limite ${avail_thresh}%)${RESET}\n"
					((st_hardware < 2)) && st_hardware=2
				else
					report+="  Available Spare...........: ${GREEN}${avail_spare}%${RESET}\n"
				fi
			fi
		else
			# ATA/SATA: tabela de atributos numerados. Indicam
			# degradação real mesmo com -H "PASSED" — um disco pode ter
			# centenas de setores realocados e ainda "passar" no teste
			# de saúde geral, que só falha perto do fim da vida útil.
			local attr_id attr_name attr_raw attr_color
			for attr_id in 5 187 197 198; do
				case "$attr_id" in
				5) attr_name="Setores realocados......" ;;
				187) attr_name="Erros não corrigidos....." ;;
				197) attr_name="Setores pendentes........" ;;
				198) attr_name="Setores incorrig. offline" ;;
				esac
				attr_raw=$(smartctl -A $smart_dtype "$disk" 2>/dev/null | awk -v id="$attr_id" '$1==id {print $NF}')
				[[ -z "$attr_raw" ]] && continue
				if [[ "$attr_raw" != "0" ]]; then
					attr_color="${YELLOW}"
					((st_hardware < 1)) && st_hardware=1
				else
					attr_color="${GREEN}"
				fi
				report+="  ${attr_name}: ${attr_color}${attr_raw}${RESET}\n"
			done
		fi
	else
		report+="SMART.............: Não instalado\n"
	fi

	# --------------------------------------------------------
	# dmesg — regex ancorada (\b...\b) para "sda" não casar com "sda1"
	# ou "sdaa"; grep -q para não vazar o match bruto por cima da tela.
	#   [categoria: HARDWARE]
	# --------------------------------------------------------
	local dev
	dev=$(basename "$disk")
	errors=$(dmesg | grep -E "\b${dev}[0-9]*\b" | tail -5)

	if [[ -n "$errors" ]]; then
		report+="\n${CYAN}Erros recentes:${RESET}\n"
		report+="${YELLOW}$errors${RESET}\n"
		if grep -qiE "I/O error|Buffer I/O|blk_update_request|critical medium error|end_request" <<<"$errors"; then
			((st_hardware < 2)) && st_hardware=2
		fi
	fi

	# --------------------------------------------------------
	# Status Final — dois status independentes
	# --------------------------------------------------------
	local final_status=$st_estrutura
	((st_hardware > final_status)) && final_status=$st_hardware

	report+="\n"
	case "$st_estrutura" in
	0) report+="${GREEN}ESTRUTURA: OK${RESET}\n" ;;
	1) report+="${YELLOW}ESTRUTURA: AVISOS ENCONTRADOS${RESET}\n" ;;
	2) report+="${RED}ESTRUTURA: POSSÍVEIS DEFEITOS${RESET}\n" ;;
	esac
	case "$st_hardware" in
	0) report+="${GREEN}HARDWARE.: OK${RESET}" ;;
	1) report+="${YELLOW}HARDWARE.: AVISOS ENCONTRADOS${RESET}" ;;
	2) report+="${RED}HARDWARE.: POSSÍVEIS DEFEITOS${RESET}" ;;
	esac

	${DIALOG} \
		--colors \
		--scrollbar \
		--backtitle "$ccabec" \
		--title "Diagnóstico do Disco" \
		--msgbox "$report" \
		00 00

	return "$final_status"
}

set_custom_install() {
	local ctitle="$1"

	if conf "${ctitle}" \
		"\n${BOLD}${WHITE}$(gettext "Uma instalação customizada irá instalar pacotes extras e também")" \
		"\n$(gettext "fazer diversas configurações, evitando faze-las manualmente posteriormente.")\n" \
		"\n${BOLD}${RED}$(gettext "Customizar a instalação?")\n\n"; then
		LCUSTOM=true
		sh_choose_custom_packages
	else
		LCUSTOM=false
	fi
}

sh_getIso() {
	if test -e '/run/initramfs/live/LiveOS/squashfs.img'; then
		return 0
	fi
	return 1
}

sh_chooseSource() {
	local -A Asource
	local -A Aflag
	local cextra
	local exit_status
	local array=()
	local x
	local _src

	Asource["local"]="${cmsg_PacotesDaImagemIso}"
	Asource["network"]="${cmsg_BaixadoDoRepositorioOficial}"
	Asource["networkFull"]="${cmsg_BaixadoDoRepositorioOficialFull}"
	cextra="${cmsg_ExtraNotIso}"

	_src=${AConfMirror[_SOURCE]}

	if ! $LHAS_INTERNET; then
		# Sem internet ao entrar na tela: não dá pra deixar network/networkFull
		# desativados de verdade (dialog radiolist não suporta isso), mas dá
		# pra pelo menos vir com "local" pré-marcado, já que é a única opção
		# que realmente funciona nesse caso. Usa a flag já calculada
		# (arranque, ou pela última vez que o item "Wifi" foi configurado),
		# sem pingar de novo aqui.
		_src="local"
		alerta "=== ${cmsg_Source^^} ===" \
			"\n${BOLD}$(gettext 'Sem conexão com a internet no momento.')" \
			"\n$(gettext 'Somente a instalação local (via ISO) será possível.')"
	fi

	for x in "${!Asource[@]}"; do
		if [[ "$_src" = "$x" ]]; then
			Aflag[$x]='on'
		else
			Aflag[$x]='off'
		fi
		if sh_getIso; then
			cextra="${cmsg_ExtraIso}"
		else
			if ! sh_checkcommand "${XBPS_INSTALL_CMD}"; then
				cextra="${cmsg_ExtraNotIso}\n${cmsg_ExtraNotHostVoid}"
			else
				cextra="${cmsg_ExtraNotIso}"
			fi
		fi
		array+=("$x" "${Asource[$x]}" "${Aflag[$x]}")
	done

	while true; do
		src=$(${DIALOG} --title "=== ${cmsg_Source^^} ===" \
			--default-item "$_src" \
			--stdout \
			--colors \
			--cancel-label "${cmsg_ButtonBack}" \
			--ok-label "${cmsg_Aceitar}" \
			--radiolist "${cmsg_MENU}\n\n$cextra" \
			12 0 0 "${array[@]}")

		exit_status=$?
		case $exit_status in
		"$D_ESC" | "$D_CANCEL")
			return 1
			;;
		"$D_OK")
			#dom 03 mar 2024 17:00:23 -04
			if [[ "$src" = "network" || "$src" = "networkFull" ]]; then
				if ! $LHAS_INTERNET; then
					alerta "=== ${cmsg_Source^^} ===" \
						"\n${BOLD}$(gettext 'Sem conexão com a internet. Escolha "local" ou configure a rede primeiro.')"
					continue
				fi
			fi

			if [[ "$src" = "networkFull" ]]; then
				if ! sh_checkcommand "${XBPS_INSTALL_CMD}"; then
					alerta "=== ${cmsg_Source^^} ===" \
						"\n${BOLD}$(gettext "Aparentemente, o VOID Linux NÃO está sendo usado como host.\nEscolha network ou ISO")"
					continue
				fi
			fi

			if [[ "$src" = "local" ]]; then
				if ! sh_getIso; then
					alerta "=== ${cmsg_Source^^} ===" "\n\n$cextra"
					continue
				else
					LSOURCE=true

					# Guarda a escolha do menu Wm pra devolver se o usuário
					# voltar pra rede. A guarda do 'local' evita que entrar
					# duas vezes seguidas em local salve 'local' por cima da
					# escolha real.
					if [[ "${_WINDOWMANAGER[0]}" != "local" ]]; then
						_WM_SAVE=("${_WINDOWMANAGER[@]}")
						_LONLY_TTY_SAVE="$LONLY_TTY"
						_DM_SAVE="$_DISPLAYMANAGER"
					fi

					_WINDOWMANAGER=('local')
					AConfMirror[_SOURCE]=$src
					LONLY_TTY=false
					_DISPLAYMANAGER='None'
					sh_ask_update_local

					if $LUPDATELOCAL; then
						set_custom_install "=== ${cmsg_Source^^} ==="
					else
						# 100% offline: customizar exigiria instalar pacotes
						# extras via rede (a lista inteira de
						# sh_choose_custom_packages é software que não vem no
						# squashfs do live), o que quebraria a promessa de não
						# tocar em rede.
						LCUSTOM=false
					fi
				fi
			elif [[ "${AConfMirror[_SOURCE]}" = "local" ]]; then
				# Só entra aqui quem está SAINDO de local para rede.
				# AConfMirror[_SOURCE] ainda tem o valor antigo neste ponto —
				# a atribuição definitiva está depois do esac.
				#
				# _WM, LMETA e as L<wm> não são tocadas pelo caminho local, então
				# já estão coerentes com o _WINDOWMANAGER restaurado.
				if ((${#_WM_SAVE[@]})); then
					_WINDOWMANAGER=("${_WM_SAVE[@]}")
					LONLY_TTY="$_LONLY_TTY_SAVE"
					_DISPLAYMANAGER="$_DM_SAVE"
					_WM_SAVE=()
				else
					# Nada guardado: sessão que já abriu em local, vinda de .conf
					_WINDOWMANAGER=('tty')
					_WM='tty'
					_DISPLAYMANAGER='None'
					LONLY_TTY=true
				fi

				LUPDATELOCAL=false
				LWM=true
			fi
			;;
		esac
		LSOURCE=true
		AConfMirror[_SOURCE]=$src
		return 0
	done
}

sh_choose_fstype() {
	local oldfstype="$1"
	local xtitle="$2"
	declare -A Afs
	declare -A Aflag
	local cextra
	local cnewmenu
	local exit_status
	local array=()
	local x

	Afs[xfs]="SGI's XFS"
	#	Afs[reiserfs]="Linux Reiserfs"
	Afs[jfs]="Linux Jfs"
	Afs[f2fs]="Flash-Friendly Filesystem"
	Afs[ext3]="Linux ext3 (journal)"
	Afs[ext2]="Linux ext2 (no journaling)"
	Afs[btrfs]="Oracle Btrfs"
	Afs[ext4]="Linux ext4 (journal)"
	Afs[vfat]="FAT32 (EFI)"
	Afs[swap]="Linux swap"
	Afs[ntfs]="Microsoft NTFS (ntfs-3g) (not for root '/')"
	Afs[nilfs2]="A log-structured file system supporting continuous snapshotting"

	if [[ -z "$oldfstype" ]]; then
		oldfstype=${AConfDisk[_FILESYSTEM]}
	fi

	for x in "${!Afs[@]}"; do
		[[ "$oldfstype" = "$x" ]] && Aflag[$x]='on' || Aflag[$x]='off'
		array+=("$x" "${Afs[$x]}" "${Aflag[$x]}")
	done

	cextra="${cmsg_mkfs}"
	cnewmenu="${xtitle:-${cmsg_MENU}}"
	mkfs=$(${DIALOG} \
		--title "${cmsg_TitleFileSystem}" \
		--default-item "$oldfstype" \
		--colors \
		--cancel-label "${cmsg_ButtonBack}" \
		--ok-label "${cmsg_Aceitar}" \
		--radiolist "${cnewmenu}\n\n$cextra" \
		24 0 2 "${array[@]}" 2>&1 >/dev/tty)

	exit_status=$?
	case $exit_status in
	"$D_ESC" | "$D_CANCEL")
