sh_init() {
	while test $# -gt 0; do
		case $1 in
		-h | -H | --help)
			sh_usage
			exit $(($# ? 0 : 1))
			;;
		-V | --version)
			sh_version
			exit $(($# ? 0 : 1))
			;;
		-f | --file)
			LFILE=1
			if [[ -n "$2" && "${2:0:1}" != '-' ]]; then
				app_conf="$2"
				shift
			fi
			sh_checkRoot
			sh_loadconf
			;;
		-n | --nocolor)
			log_msg "$(gettext "Desligando saída de cores")"
			sh_unsetVarColors
			;;
		-q | --quiet)
			log_msg "$(gettext "Ativando resumo na saída")"
			quiet=1
			;;
		-g | --grafico)
			log_msg "$(gettext "Ligando modo gráfico")"
			grafico=1
			;;
		-i | -I | --install)
			sh_checkRoot
			LINSTALL=true
			appexec+=('sh_main_menu')
			;;
		-c | -C | --chroot)
			sh_checkRoot
			LCHROOT=true
			appexec+=('sh_dryrun')
			;;
		*) die "${cmsg_operNotSupported}: $1 $(gettext 'usar -h para ajuda')" ;;
		esac
		shift
	done
}

