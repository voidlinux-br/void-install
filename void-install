sh_make_fstab() {
	local i
	local _part
	local label
	local fstype
	local format
	local size
	local mntpoint
	local fsorder=1

	if ! $LVM; then
		sh_info_msg "${cmsg_Gerando} fstab pass1"
		echo "tmpfs /tmp tmpfs defaults,nosuid,nodev,noatime,mode=1777 0 0" >"$dir_install/etc/fstab"
		#		echo "tmpfs /var/log tmpfs defaults,noatime,mode=0755 0 0" >>"$dir_install/etc/fstab"
		echo "proc /proc proc nodev,noexec,nosuid 0 0" >>"$dir_install/etc/fstab"

		for i in "${!Amntpoint[@]}"; do
			_part="$i"
			mntpoint="$(sh_splitarray "${Amntpoint[$i]}" 1)"
			fstype="$(sh_splitarray "${Amntpoint[$i]}" 2)"
			format="$(sh_splitarray "${Amntpoint[$i]}" 3)"

			fsorder=1
			if [ "$fstype" = "f2fs" -o "$fstype" = "btrfs" -o "$fstype" = "xfs" -o "$fstype" = "reiserfs" ]; then
				fsorder=0
			fi

			if [ "$fstype" = "swap" ]; then
				echo "UUID=$(blkid -o value -s UUID "${_part}") none swap none,nofail 0 0" >>"$dir_install/etc/fstab"
				continue
			fi

			if [ "$mntpoint" = "none" ] && [ "$fstype" = "-" ]; then
 				continue
 			fi

			if [ -n "$mntpoint" ]; then
				if [ "$mntpoint" = '/boot/efi' ]; then
					echo "UUID=$(blkid -o value -s UUID "${_part}") ${mntpoint} ${fstype,,} defaults 0 2" >>"$dir_install/etc/fstab"
				else
					if [ "$format" = 0 ]; then
						if [ "$mntpoint" = 'none' ]; then
							((++Npoint))
							mntpoint="/mnt/none${Npoint}"
							mkdir -p "$dir_install/${mntpoint}"
						fi
						echo "UUID=$(blkid -o value -s UUID "${_part}") ${mntpoint} ${fstype,,} defaults,nofail,noatime,discard,lazytime 0 $fsorder" >>"$dir_install/etc/fstab"
					else
						echo "UUID=$(blkid -o value -s UUID "${_part}") ${mntpoint} ${fstype,,} defaults,noatime,discard,lazytime 0 $fsorder" >>"$dir_install/etc/fstab"
					fi
				fi
			fi
		done
	#		evaluate_retval "$?"
	else
		sh_info_msg "${cmsg_Gerando} fstab pass1"
		echo "tmpfs /tmp tmpfs defaults,nosuid,nodev,noatime,mode=1777 0 0" >"$dir_install/etc/fstab"
		echo "proc /proc proc nodev,noexec,nosuid 0 0" >>"$dir_install/etc/fstab"

		for i in "${!AmntpointFDE[@]}"; do
			_part="$i"
			label="$(sh_splitarray "${AmntpointFDE[$i]}" 1)"
			fstype="$(sh_splitarray "${AmntpointFDE[$i]}" 2)"
			format="$(sh_splitarray "${AmntpointFDE[$i]}" 3)"
			size="$(sh_splitarray "${AmntpointFDE[$i]}" 4)"
			mntpoint="$(sh_splitarray "${AmntpointFDE[$i]}" 5)"
			#			echo "UUID=$(blkid -o value -s UUID "${_part}") $mntpoint ${fstype,,} defaults 0 0" >>"$dir_install/etc/fstab"
			echo "UUID=$(blkid -o value -s UUID "${_part}") $mntpoint ${fstype,,} defaults,noatime,discard,lazytime 0 0" >>"$dir_install/etc/fstab"
		done

		# /boot/efi precisa vir DEPOIS das entradas acima no arquivo — se
		# existir uma LV separada pra /boot (campo novo), o boot real monta
		# seguindo a ordem do fstab, e /boot/efi mora DENTRO de /boot. Se a
		# linha de /boot/efi viesse antes, o boot tentava montar ali sem
		# /boot ainda existir como filesystem (confirmado em log real:
		# "mount point does not exist"). No chroot da instalação isso nunca
		# apareceu porque sh_mount_fs (função separada) já monta na ordem
		# certa por conta própria — só a ordem GRAVADA no arquivo importava.
		for i in "${!Amntpoint[@]}"; do
			_part="$i"
			mntpoint="$(sh_splitarray "${Amntpoint[$i]}" 1)"
			fstype="$(sh_splitarray "${Amntpoint[$i]}" 2)"
			format="$(sh_splitarray "${Amntpoint[$i]}" 3)"

			if [[ "$mntpoint" = "/boot/efi" ]]; then
				echo "UUID=$(blkid -o value -s UUID "${_part}") ${mntpoint} ${fstype,,} defaults 0 2" >>"$dir_install/etc/fstab"
				break
			fi
		done
		#		evaluate_retval "$?"
	fi

	sh_chroot_job "${cmsg_Gerando} fstab pass2" "
    sed 's/#.*//' /etc/fstab | column --table --table-columns SOURCES,DIR,TYPE,OPTIONS,DUMP,PASS --table-hide - >/tmp/fstab
    sed -i 's/SOURCES/#SOURCE/' /tmp/fstab
    cp /tmp/fstab /etc/fstab
  " $err_not_fatal
}

sh_activating_services() {
	#dica: No Void, com dbus ativo, o elogind e o polkitd sobem automaticamente.
	#      Você não precisa ativar os serviços deles no runit.
	local service
	local level=2
	aServicesTTY+=(dbus sshd chronyd udevd uuidd dmeventd socklog-unix)
	aServicesX+=()

	if ! $LSERVER && ! $LONLY_TTY; then
		aServicesX+=(bluetoothd)
	fi

	for x in "${aDE[@]}"; do
		case $x in
		tty | server | xorg) continue ;;
		*)
			[[ "$_DISPLAYMANAGER" != "None" ]] && aServicesX+=("$_DISPLAYMANAGER")
			break
			;;
		esac
	done

	# Em local o runsvdir do destino veio inteiro no rsync do squashfs, já com
	# o DM da ISO habilitado. Trocar de DM sem remover o link antigo deixa os
	# dois disputando o tty7. Só acontece com LUPDATELOCAL, único caso em que
	# sh_choose_dm abre o menu (6349).
	#
	# A lista acompanha o case de sh_configure_display_manager (721): DM novo
	# lá, DM novo aqui.
	#
	# Roda antes do loop de aServicesX, que é quem cria o link do DM escolhido.
	# O continue protege o escolhido, então se o usuário não trocou nada,
	# nenhum link é removido.
	if [[ "${AConfMirror[_SOURCE]}" = "local" ]] && $LUPDATELOCAL && [[ "$_DISPLAYMANAGER" != "None" ]]; then
		for service in lightdm sddm gdm lxdm; do
			[[ "$service" = "$_DISPLAYMANAGER" ]] && continue
			sh_chroot_job "$(gettext 'Desativando serviço') $service" \
				"rm -f /etc/runit/runsvdir/current/$service" \
				"$err_not_fatal" \
				"$level"
		done
	fi

	for service in "${aServicesTTY[@]}"; do
		sh_chroot_job "${cmsg_AtivandoServico} $service" \
			"ln -sf /etc/sv/$service /etc/runit/runsvdir/current/" \
			"$err_not_fatal" \
			"$level"
	done

	if ! $LONLY_TTY; then
		for service in "${aServicesX[@]}"; do
			sh_chroot_job "${cmsg_AtivandoServico} $service" \
				"ln -sf /etc/sv/$service /etc/runit/runsvdir/current/" \
				"$err_not_fatal" \
				"$level"
		done
	fi
}

