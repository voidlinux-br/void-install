sh_tar_rootfs() {
	sh_checkTarball || return 1
	sh_info_msg "${cmsg_Descompactando} rootfs"
	tar xpf "$_TARBALL_ROOTFS" --xattrs-include='*.*' --numeric-owner -C $dir_install 2>&1 | tee -i -a "$BOOTLOG" >$LOGGER
	ret="${PIPESTATUS[0]}"
	if [[ "$ret" -eq 0 ]]; then
		evaluate_retval "$ret"
		return "$ret"
	else
		evaluate_retval "$ret" "$err_not_fatal"
		sh_umount_fs
		if conf "${YELLOW}${_TARBALL_ROOTFS}" "${cmsg_Tarball_Corrompido}"; then
			sh_checkIntegrityTarball || return 1
			sh_install
		else
			die "${cmsg_ERRO} tar '#'$ret. ${cmsg_ErroTar} $_TARBALL_ROOTFS"
		fi
	fi
}

sh_execcopia() {
	ORIGEM="/run/rootfsbase/"
	DESTINO="$dir_install/"
	DEST="$dir_install"
	PONT='|/—\' # Ponteiros de um hélice do lado direito
	nVal=0

	sizeof() { du -s "$1" 2>/dev/null | cut -f1; }
	running() { ps "$1" | grep "$1" >/dev/null; }

	TITLE="INSTALL"
	#   INTERVALO=0.001
	INTERVALO=0.5
	#   PORCENTO=0
	DIR_DESTINO="$DESTINO/${ORIGEM##*/}"
	MSG="Aguarde, instalando... if=$ORIGEM of=$DESTINO"
	#   MSG=$(eval echo "$MSG")
	mensagem "Aguarde, computando arquivos para instalar"
	#   TOTAL=$(unsquashfs -ll "$LIVE_DIR" | awk '{n+=$3} END {print n}')
	#   TOTAL=$((TOTAL/1024))
	#  TOTALGB=$((TOTAL/1024))
	TOTAL=$(sizeof "$ORIGEM")
	TOTALGB=$((TOTAL / 1024))
	DISPONIVEL=$(df | grep "${DEST}" | awk '{print $4}' | head -1)
	DISPONIVEL=$((DISPONIVEL / 1024))

	if ((DISPONIVEL < TOTALGB)); then
		if ! confmulti "$(gettext '*** AVISO ***')" \
			"\n$(gettext 'Tamanho da partição destino é menor que o necessário')\n" \
			"\n$(gettext 'Partição destino')   : ${part}" \
			"\n$(gettext 'Tamanho disponível') : ${DISPONIVEL}G" \
			"\n$(gettext 'Tamanho necessário') : ${TOTALGB}G" \
			"\n\n$(gettext 'Sistema destino poderá não funcionar, continuar?')"; then
			#           sh_stop_bind
			#           sh_stop_mount
			#           sh_main_menu "$@"
			return 1
		fi
	fi

	log="/tmp/${_APP_}.log"
	[ -e "$log" ] && rm -f "$log"

	rsync -crav "$ORIGEM" "$DESTINO" 1>&2 >"$log" &
	export CPPID=$!

	#  trap sh_trapErro 2 15
	#trap "kill $CPPID" 2 15
	(
		while running "$CPPID"; do
			((nval >= 4)) && nval=0
			COPIADO=$(sizeof "$DIR_DESTINO")
			PERCENTAGEM=$((COPIADO * 100 / TOTAL))
			COPIADOMB=$((COPIADO / 1024))
			LASTFILE=$(tail -n1 "$log")
			[[ "$PERCENTAGEM" -gt 100 ]] && PERCENTAGEM=100
			${DIALOG} --colors \
				--title $TITLE \
				--gauge "$MSG                                       \n$(gettext 'Falta') ${RED}${REVERSE}$((100 - PERCENTAGEM))%${RESET} $(gettext 'para completar a tarefa') \Zb\Z1${PONT:nval:1}\ZB\Zn \
                                    \n\n$(gettext 'Destino')    : ${BLUE}${REVERSE}${AConfDisk[_DEVICE]}$dir_install${RESET}
                                    \n$(gettext 'Disponivel') : ${DISPONIVEL}MB\
                                    \n$(gettext 'Total')      :  ${TOTALGB}MB\
                                    \n$(gettext 'Copiado')    :  ${BLUE}${REVERSE}${COPIADOMB}MB${RESET}\
                                    \n$(gettext 'Arquivo')    : ${LASTFILE}\
                                    \n" 13 130 0 <<<$PERCENTAGEM
			((nval++))
			#           sleep $INTERVALO
		done
	)
	return 0
}

sh_populate_mountpoints() {
	local parent="${AConfDisk[_DEVICE]}"
	local dev fs mp
	local formatar=1

	# zera o array global
	Amntpoint=()

	while read -r dev fs mp; do
		# swap não tem mountpoint
		if [[ "$fs" == "swap" ]]; then
			mp="none"
		fi

		mp="${mp:-none}"
		fs="${fs:-unknown}"
		Amntpoint["$dev"]="$mp|$fs|$formatar"
	done < <(
		lsblk -lnpo NAME,FSTYPE,MOUNTPOINT "$parent" | tail -n +2
	)
}

sh_rebind_amntpoint_device() {
	local new_device="${AConfDisk[_DEVICE]}"
	local old_device
	local dev newdev
	local -A _new

	# array vazio? nada a fazer
	((${#Amntpoint[@]})) || return 0

	# descobre o device antigo a partir da primeira chave
	for dev in "${!Amntpoint[@]}"; do
		old_device="${dev%p*}"
		break
	done

	# se for o mesmo device, não altera
	[[ "$old_device" == "$new_device" ]] && return 0

	# copia mudando o prefixo do device
	for dev in "${!Amntpoint[@]}"; do
		newdev="${dev/#$old_device/$new_device}"
		_new["$newdev"]="${Amntpoint[$dev]}"
	done

	# substitui o array original
	Amntpoint=()
	for dev in "${!_new[@]}"; do
		Amntpoint["$dev"]="${_new[$dev]}"
	done
}

# Checagem rápida e ao vivo (sem depender de arrays já populados) se o
# dispositivo tem alguma partição LUKS de uma instalação anterior. Usada
# tanto ao escolher disco quanto ao entrar no menu FileSystem.
sh_has_luks_remnant() {
	local device="$1"
	[[ -n "$device" && "$device" != "/dev/sdX" ]] || return 1
	lsblk -no FSTYPE "$device" 2>/dev/null | grep -qx "crypto_LUKS"
}

# Aviso padrão (só OK) usado quando a detecção de LUKS remanescente acontece
# fora de um fluxo interativo de particionamento (ex: sh_rebuild_amntpoint_for_new_disk).
# Marca o filesystem como inválido para forçar o usuário a reparticionar.
sh_alert_luks_remnant() {
	LMKPARTED=false
	LFSREVISED=false
	alerta "${RED}${REVERSE}$(gettext '=== CONTAINER LUKS ENCONTRADO ===')" \
		"$(gettext 'Foi encontrada uma partição LUKS de uma instalação anterior neste disco.')" \
		"$(gettext 'Ela não será reaproveitada e não pode ser usada como está.')" \
		"" \
		"${BOLD}${YELLOW}$(gettext 'É necessário reparticionar o disco do zero para continuar.')${RST}"
}

sh_rebuild_amntpoint_for_new_disk() {
	local device="${AConfDisk[_DEVICE]}"
	local efi_set=false
	local swap_set=false
	local root_set=false
	local home_set=false
	local luks_found=false
	local fs

	[[ -n "$device" ]] || return 1

	#   # se já existe algo desse device, não refaz
	#   for fs in "${!Amntpoint[@]}"; do
	#      [[ "$fs" == "$device"* ]] && return 0
	#   done
	#
	Amntpoint=()

	while read -r line; do
		eval "${line//=/_=}"

		# só partições
		[[ "$TYPE_" == "part" ]] || continue

		# partição já criptografada (LUKS) de instalação anterior: não é reaproveitável,
		# não entra no mapa de mountpoints. Marca que o disco precisa ser reparticionado do zero.
		if [[ "$FSTYPE_" == "crypto_LUKS" ]]; then
			luks_found=true
			continue
		fi

		# bios_grub tem prioridade sobre qualquer FSTYPE detectado — mesmo com
		# resíduo de vfat (ex.: sobra de uma instalação anterior que causava
		# "contains a recognised filesystem" no limine bios-install), essa
		# partição nunca é a EFI real. name 1 BIOS é gravado por nós mesmos em
		# sh_mkparted, então PARTLABEL_="BIOS" identifica ela com segurança,
		# independente do que sobrou de FSTYPE_.
		if [[ "$PARTLABEL_" == "BIOS" || "$PARTTYPENAME_" == *BIOS* ]]; then
			continue
		fi

		# --- CASO 1: FSTYPE EXISTE ---
		if [[ -n "$FSTYPE_" ]]; then
			case "$FSTYPE_" in
			vfat)
				Amntpoint["$PATH_"]="/boot/efi|vfat|1"
				efi_set=true
				continue
				;;
			swap)
				Amntpoint["$PATH_"]="none|swap|1"
				swap_set=true
				continue
				;;
			LVM2_member)
				# Resíduo de LVM de uma instalação anterior nessa partição — não
				# é um filesystem de verdade (não existe "mkfs.LVM2_member"),
				# trata como ext4 reaproveitável, igual uma partição comum.
				fs="ext4"
				;;
			*)
				fs="$FSTYPE_"
				;;
			esac

		# --- CASO 2: FSTYPE VAZIO → PARTTYPENAME ---
		else
			case "$PARTTYPENAME_" in
			*BIOS*)
				continue
				;;
			*EFI*)
				Amntpoint["$PATH_"]="/boot/efi|vfat|1"
				efi_set=true
				continue
				;;
			*swap*)
				Amntpoint["$PATH_"]="none|swap|1"
				swap_set=true
				continue
				;;
			*NTFS*)
				Amntpoint["$PATH_"]="/home|ntfs|1"
				home_set=true
				continue
				;;
			*"Linux"*)
				fs="ext4"
				;;
			*)
				continue
				;;
			esac
		fi

		# --- FILESYSTEM NORMAL (ext4, xfs, etc) ---
		case "$PARTLABEL_" in
		ROOT)
			Amntpoint["$PATH_"]="/|$fs|1"
			root_set=true
			;;
		HOME)
			Amntpoint["$PATH_"]="/home|$fs|1"
			home_set=true
			;;
		*)
			case "$PTTYPE_" in
			gpt) Amntpoint["$PATH_"]="none|$fs|0" ;;
			dos)
				if ! $root_set; then
					Amntpoint["$PATH_"]="/|$fs|1"
					root_set=true
				else
					if ! $home_set; then
						Amntpoint["$PATH_"]="/home|$fs|1"
						home_set=true
					else
						Amntpoint["$PATH_"]="none|$fs|0"
					fi
				fi
				;;
			esac
			;;
		esac

	done < <(
		lsblk -fPAo PTTYPE,TYPE,NAME,PATH,SIZE,TRAN,MODEL,LABEL,SERIAL,FSTYPE,PARTTYPENAME,PARTLABEL "$device" |
			grep -P 'TYPE="(part)"' |
			sort -k5,5 -k2,2
	)

	if $luks_found; then
		sh_alert_luks_remnant
	else
		((${#Amntpoint[@]})) && LMKPARTED=true || LMKPARTED=false
	fi
}

sh_check_lock() {
	if [[ -e "$LOCKFILE" ]]; then
		# Verifica se o processo ainda existe
		local pid
		pid=$(cat "$LOCKFILE")
		if kill -0 "$pid" 2>/dev/null; then
			die "O script já está em execução (PID: $pid)."
			exit 1
		fi
	fi
	echo $$ >"$LOCKFILE"
	trap 'rm -f "$LOCKFILE"; exit' INT TERM EXIT
}

sh_checkUpdatePackages() {
	local TMP_FILE="/tmp/$(basename "$0").restarted"
	local PackagesToUpdate=(void-install)

	sh_msg_job "Distro detectada : ${CYAN}${DISTRO}${RST}"

	if [[ "$DISTRO" = @(void|void-live|voidlinux|voidbr) ]]; then
		# adiciona repositorios inexistentes no /etc/xbps.d/00-repository-main.conf
		#sh_add_repo

		if [[ ! -f "$TMP_FILE" ]]; then
			# Vital em ISOs antigas: bugs já corrigidos numa versão mais nova
			# do instalador só chegam aqui atualizando. Só é chamada quando
			# há internet (sh_without_chroot já garante isso) — mas o pacote
			# void-install pode estar em repositórios diferentes dependendo
			# da ISO/distro (voidbr.org, voidlinux.com.br, chililinux).
			# Testar só "existe internet" não garante que ESSE pacote está
			# resolvível.
			if xbps-query -R "${PackagesToUpdate[0]}" >/dev/null 2>&1; then
				if conf "** UPDATE - ${APP} **" "É fortemente recomendado sincronizar e atualizar este utilitário antes da instalação. \n\n${AMARELO}Deseja proceder ?"; then
					if sh_cmd_job_infobox "Aguarde alguns instantes, sincronizando e atualizando..." \
						"xbps-install -Syuf --ignore-file-conflicts ${PackagesToUpdate[*]}"; then
						sh_msg_job "Reiniciando o script pela primeira vez..."
						touch "$TMP_FILE"
						exec "$0" "$@"
					else
						# Update falhou (repositório fora do ar, pacote não
						# encontrado, etc.) — não finge sucesso, avisa e segue
						# com a versão atual em vez de reiniciar às cegas.
						alerta "** UPDATE - ${APP} **" \
							"${RED}A atualização falhou.${RST}" \
							"\n${YELLOW}Prosseguindo com a versão atual do instalador (v${_VERSION_}).${RST}"
					fi
				fi
			else
				sh_info_msg "$(gettext 'Pacote de atualização indisponível nos repositórios configurados — prosseguindo com a versão atual do instalador') (v${_VERSION_})."
			fi
		fi
		# verifica dependencias
		#check_dependencies
	else
		touch "$TMP_FILE"
	fi
}

# Teste puro de conectividade, sem efeito colateral nenhum (não mostra
# diálogo, não oferece configurar Wi-Fi). Ao vivo — nunca usa estado salvo
# (LHAS_INTERNET pode estar desatualizado se o usuário conectou depois via
# o menu "Wifi"). Genérica: usar em qualquer parte do script que precise
# saber o estado atual da rede.
sh_has_internet() {
	ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1
}

# Testa os repositórios conhecidos do Void, em ordem de precedência, e para
# no primeiro que responder (não testa os outros à toa). Ter internet não
# garante que ESSES repositórios especificamente estão no ar. Se algum
# responder, já deixa configurado em url_mirror/AConfMirror[_MIRROR] — as
# mesmas variáveis usadas pelo resto do script (chaves iguais às de
# Amirror, pra ficar consistente com a tela de Mirror).
sh_has_repo_online() {
	local -A _repos=(
		['void.voidbr.org']='https://void.voidbr.org/voidlinux/'
		['void.voidlinux.com.br']='https://void.voidlinux.com.br/voidlinux/'
		['void.chililinux.com']='https://void.chililinux.com/voidlinux/'
	)
	local key

	sh_info_msg "$(gettext 'Testando repositórios do VoidBR...')"

	# Sem internet nenhuma, nem vale a pena testar os repositórios um por
	# um (cada tentativa pode levar até 5s de timeout).
	if ! sh_has_internet; then
		LREPO_ONLINE=false
		return 1
	fi

	for key in void.voidbr.org void.voidlinux.com.br void.chililinux.com; do
		sh_info_msg "$(gettext 'Testando repositório'): ${CYAN}${key}${RST}"
		if [[ "$(curl -o /dev/null -s -w '%{http_code}\n' --max-time 5 "${_repos[$key]}")" = "200" ]]; then
			AConfMirror[_MIRROR]="$key"
			url_mirror="${_repos[$key]}"
			LREPO_ONLINE=true
			sh_info_msg "${GREEN}$(gettext 'Repositório online'): ${key}${RST}"
			return 0
		fi
	done
	LREPO_ONLINE=false
	sh_info_msg "${RED}$(gettext 'Nenhum repositório respondeu')${RST}"
	return 1
}

sh_check_internet() {
	local pipe_test="1"

	if sh_cmd_job "$(gettext 'Testando conexão com a internet...')" \
		"sh_has_internet" \
		"$err_not_fatal" "$pipe_test"; then
		LHAS_INTERNET=true
		return 0
	else
		if conf "** INTERNET **" \
			"$(gettext 'Parece que não há uma rota disponível para a internet.') \n\n${AMARELO}$(gettext 'Deseja configurar um Wi-Fi?')"; then
			sh_run_binary 'voidbr-wifi-setup'
			if sh_has_internet; then
				LHAS_INTERNET=true
				return 0
			else
				LHAS_INTERNET=false
				AConfMirror[_SOURCE]='local'
				return 1
			fi
		fi
		LHAS_INTERNET=false
		AConfMirror[_SOURCE]='local'
		return 1
	fi
}

# Instalação "local" (ISO/pendrive): por padrão não depende de rede nenhuma,
# usando só o que já foi copiado do sistema live (rsync do squashfs, que já
# inclui o próprio banco de dados do xbps). Se detectar internet disponível,
# pergunta se o usuário quer aproveitar pra atualizar bootloader/pacotes base
# durante a instalação; se não tiver rede, ou responder não, segue 100%
# offline. Define LUPDATELOCAL, usada mais adiante em sh_install().
sh_ask_update_local() {
	LUPDATELOCAL=false
	if sh_cmd_job "$(gettext 'Verificando conexão com a internet...')" \
		"sh_has_internet" \
		"$err_not_fatal" "1"; then
		if conf "=== $(gettext 'ATUALIZAR PACOTES') ===" \
			"\n${GREEN}$(gettext 'Conexão com a internet detectada.')${RST}\n" \
			"\n$(gettext 'Os pacotes da ISO podem estar desatualizados. Deseja atualizar o bootloader e os pacotes base pela internet durante a instalação?')\n" \
			"\n${YELLOW}$(gettext 'Se não, a instalação usa somente o que já vem no sistema live (100% offline).')${RST}"; then
			LUPDATELOCAL=true
		fi
	else
		sh_info_msg "$(gettext 'Sem conexão com a internet — instalação local seguirá 100% offline.')"
	fi
}

