			--backtitle "$ccabec" \
			--infobox "\n[${BOLD}${YELLOW}${ufmt}] ${RESET}${BOLD}$logmessage" \
			6 100
	else
		log_info_msg "$(fmt) ${logmessage}"
	fi
}

fmt() {
	printf "${bold}${yellow}%03d/%03d${reset}" "$ncounter" "$njobs"
	return $?
