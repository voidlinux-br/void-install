	chostname="${AsUser[chostname]}"
	if [[ -z "$chostname" || "$chostname" == "${chostname_base,,}" || "$chostname" == "${chostname_base,,}-"* ]]; then
		chostname="${chostname_base}-$(sh_get_edition_label)"
