sh_configure_dhcpcd_static_ip_dialog() {
	local CONFIG_FILE="/etc/dhcpcd.conf"
	local DEFAULT_IFACE

	# detecta interface padrão
	DEFAULT_IFACE="$(get_default_iface)"

	sh_setAsDhcp

	# formulário
	local ncol=18
	while true; do
		dhcptext=$(dialog \
			--backtitle "$ccabec" \
			--title "$(gettext "Configuração de IP fixo (dhcpcd)")" \
			--form "$(gettext "Preencha os dados:")" \
			15 60 6 \
			"Interface      : " 1 1 "${AsDhcp[IFACE]}" 1 $ncol 20 0 \
			"IP             : " 2 1 "${AsDhcp[IP]}" 2 $ncol 20 0 \
			"Máscara (CIDR) : " 3 1 "${AsDhcp[CIDR]}" 3 $ncol 20 0 \
			"Gateway        : " 4 1 "${AsDhcp[GATEWAY]}" 4 $ncol 20 0 \
			"DNS 1          : " 5 1 "${AsDhcp[DNS1]}" 5 $ncol 20 0 \
			"DNS 2          : " 6 1 "${AsDhcp[DNS2]}" 6 $ncol 20 0 \
			2>&1 >/dev/tty)

		exit_status=$?
		case $exit_status in
		"$D_ESC" | "$D_CANCEL")
			return
			;;
		"$D_OK")
			# extrai valores
			mapfile -t adhcp <<<"$dhcptext"
			AsDhcp[IFACE]="${adhcp[0]}"
			AsDhcp[IP]="${adhcp[1]}"
			AsDhcp[CIDR]="${adhcp[2]}"
			AsDhcp[GATEWAY]="${adhcp[3]}"
			AsDhcp[DNS1]="${adhcp[4]}"
			AsDhcp[DNS2]="${adhcp[5]}"

			# mensagem confirmação
			CONFIRM_MSG="$(printf "%s\n\n%-20s: %s\n%-20s: %s/%s\n%-20s: %s\n%-20s: %s %s" \
				"${BOLD}${RED}$(gettext "Aplicar essas configurações?")${RESET}" \
				"$(gettext "Interface")" "${YELLOW}${AsDhcp[IFACE]}${RST}" \
				"$(gettext "IP")" "${YELLOW}${AsDhcp[IP]}" "${AsDhcp[CIDR]}${RST}" \
				"$(gettext "Gateway")" "${YELLOW}${AsDhcp[GATEWAY]}${RST}" \
				"$(gettext "DNS")" "${YELLOW}${AsDhcp[DNS1]}" "${AsDhcp[DNS2]}${RST}")"

			#   dialog --yesno "$CONFIRM_MSG" 12 50
			if conf "=== DHCP ===" "$CONFIRM_MSG"; then
				LDHCP=true
			fi
			;;
		esac
		return 0
	done
}

