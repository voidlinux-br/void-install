sh_confLvm() {
	local size
	local FdeText
	local arr
	local disk
	local _part
	local dsk
	local oldfstype
	local flag
	local mntpoint
	local fstype
	local i
	local rootfound=0
	local ctitlemenu
	local VGs
	local PVs
	local _vg_pv
	local _old_vg

	if [[ "$menu" = "Fde" ]]; then
		ctitlemenu='FDE CONFIG'
		LCONFIGFDE=1
	else
		ctitlemenu='LVM CONFIG'
		LCONFIGFDE=0
	fi

	if ! $LDISK; then
		alerta "${RED}${REVERSE}$ctitlemenu ${cmsg_TitleDisco}" "${RED}${REVERSE}${cmsg_NotConfDisco^^}"
		DEFITEM="${cmsg_Disco}"
		return 1
	elif ! $LPARTITION; then
		alerta "${RED}${REVERSE}$ctitlemenu $(gettext "=== PARTIÇÃO ===")" "${RED}${REVERSE}${cmsg_NotConfFileSystem^^}"
		DEFITEM="FileSystem"
		return 1
	fi

	sh_disk_part_info
	disk="${AConfDisk[_BOOTLOADER]}|\
$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_BOOTLOADER]}]}" "$DSK_TRAN")|\
$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_BOOTLOADER]}]}" "$DSK_SIZE")|\
$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_BOOTLOADER]}]}" "$DSK_PTTYPE")|\
$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_BOOTLOADER]}]}" "$DSK_MODEL")|\
$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_BOOTLOADER]}]}" "$DSK_LABEL")|\
$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_BOOTLOADER]}]}" "$DSK_SERIAL")"

	for i in "${!Amntpoint[@]}"; do
		_part="$i"
		dsk="${_part%%[p0-9]*([0-9])}"
		size="$(sh_splitarray "${AARRAY_PART_DEVICES[$_part]}" 2)"
		oldfstype="$(sh_splitarray "${AARRAY_PART_DEVICES[$_part]}" 7)"
		flag="$(sh_splitarray "${AARRAY_PART_DEVICES[$_part]}" 8)"
		mntpoint="$(sh_splitarray "${Amntpoint[$_part]}" 1)"
		fstype="$(sh_splitarray "${Amntpoint[$_part]}" 2)"

		if [ "$mntpoint" = "/" ]; then
			AConfFde[partition]="$_part"
			((++rootfound))
			break
		fi
	done

	if [ "$rootfound" -eq 0 ]; then
		${DIALOG} \
			--colors \
			--msgbox "${BOLD}${RED}ERROR:${RESET} $(gettext 'o ponto de montagem para o sistema de arquivos raiz (/) ainda não foi configurado.')" \
			8 75
		return 1
	fi

	# Sugere um nome de VG baseado no disco (ex: /dev/mapper/pve-lvm ->
	# voidbrlvm, /dev/sda -> voidbrsda) sempre que o campo estiver vazio —
	# vazio é o sinal de "nunca foi definido" (nem pelo usuário, nem vindo
	# do .conf). Se já tiver algo ali (customizado ou carregado), preserva.
	if [[ -z "${AConfFde[vg]}" ]]; then
		local _vg_suffix="${AConfDisk[_DEVICE]##*/}"
		_vg_suffix="${_vg_suffix##*-}"
		AConfFde[vg]="voidbr${_vg_suffix}"
	fi

	# Mostra a tela de instrução só na primeira vez — se já teve um
	# preenchimento bem-sucedido antes (LFDE ou LVM já true), o usuário já
	# sabe como funciona; ao reabrir só pra editar, pula direto pro
	# formulário, sem repetir a explicação.
	if ! $LFDE && ! $LVM; then
		${DIALOG} \
			--colors \
			--clear \
			--no-collapse \
			--no-cr-wrap \
			--title "=== $ctitlemenu ===" \
			--backtitle "$ccabec" \
			--ok-label "${cmsg_ok}" \
			--msgbox "\n${BOLD}$(gettext 'Como preencher os percentuais dos volumes lógicos:')${RST}\n$(gettext 'Cada percentual é relativo ao TOTAL do espaço reservado — não precisa se preocupar com "o que sobra", o script calcula isso por você.')\n\n${YELLOW}$(gettext 'A SOMA de tudo que você preencher precisa fechar, no máximo, 100%.')${RST}\n$(gettext 'Digite só o número, sem o "%" (ex: root=25, boot=2, var=5, home=68 — soma=100 cria os quatro volumes nesses tamanhos exatos).')\n\n${YELLOW}$(gettext 'Padrão: root=100, boot/swap/var/home em branco')${RST} — $(gettext 'tudo fica dentro de uma única partição; boot, swap, var e home continuam existindo como pastas normais dentro de /, sem volume lógico separado.')\n\n$(gettext 'Deixe em branco (ou \"0\") o campo que não quiser como volume separado.')\n\n$(gettext 'Também aceita tamanho absoluto em vez de percentual (ex: 10G, 500M) — nesse caso é descontado do total, e os demais percentuais se referem ao que sobrou.')" \
			0 0
	fi

	while true; do
		exec 3>&1

		# Monta os campos dinamicamente: Passphrase/Verify Passphrase só fazem
		# sentido no modo Fde (LUKS). No modo Lvm puro, sem criptografia, não
		# há motivo pra pedir senha nenhuma — os campos nem aparecem.
		local -a formargs=()
		local nextrow=1
		local idx=0
		local idx_vg idx_pass=-1 idx_verify=-1 idx_lvroot idx_lvboot idx_lvswap idx_lvvar idx_lvhome

		formargs+=("Disk: " "$nextrow" 1 "$disk" "$nextrow" 42 40 0 2)
		((idx++, nextrow++))
		formargs+=("Partition: " "$nextrow" 1 "$_part" "$nextrow" 42 40 0 2)
		((idx++, nextrow++))
		formargs+=("Size: " "$nextrow" 1 "$size" "$nextrow" 42 40 0 2)
		((idx++, nextrow++))
		formargs+=("Old FS: " "$nextrow" 1 "$oldfstype" "$nextrow" 42 40 0 2)
		((idx++, nextrow++))
		formargs+=("New FS: " "$nextrow" 1 "$fstype" "$nextrow" 42 40 0 2)
		((idx++, nextrow++))
		formargs+=("Flag: " "$nextrow" 1 "$flag" "$nextrow" 42 40 0 2)
		((idx++, nextrow++))
		formargs+=("Volume Group: " "$nextrow" 1 "${AConfFde[vg]}" "$nextrow" 42 25 0 0)
		idx_vg=$idx
		((idx++, nextrow++))

		if [[ "$menu" = "Fde" ]]; then
			formargs+=("Passphrase: " "$nextrow" 1 "${AConfFde[passphrase]}" "$nextrow" 42 20 0 1)
			idx_pass=$idx
			((idx++, nextrow++))
			formargs+=("Verify Passphrase: " "$nextrow" 1 "${AConfFde[verifypassphrase]}" "$nextrow" 42 20 0 1)
			idx_verify=$idx
			((idx++, nextrow++))
		fi

		formargs+=("Logical volume (/): " "$nextrow" 1 "${AConfFde[lvroot]}" "$nextrow" 42 15 0 0)
		idx_lvroot=$idx
		((idx++, nextrow++))
		formargs+=("Logical volume (/boot) (empty to none): " "$nextrow" 1 "${AConfFde[lvboot]}" "$nextrow" 42 15 0 0)
		idx_lvboot=$idx
		((idx++, nextrow++))
		formargs+=("Logical volume (/swap) (empty to none): " "$nextrow" 1 "${AConfFde[lvswap]}" "$nextrow" 42 15 0 0)
		idx_lvswap=$idx
		((idx++, nextrow++))
		formargs+=("Logical volume (/var)  (empty to none): " "$nextrow" 1 "${AConfFde[lvvar]}" "$nextrow" 42 15 0 0)
		idx_lvvar=$idx
		((idx++, nextrow++))
		formargs+=("Logical volume (/home) (empty to none): " "$nextrow" 1 "${AConfFde[lvhome]}" "$nextrow" 42 15 0 0)
		idx_lvhome=$idx
		((idx++, nextrow++))

		FdeText=$(${DIALOG} \
			--title "=== $ctitlemenu ===" \
			--colors \
			--ok-label "${cmsg_Aceitar}" \
			--cancel-label "${cmsg_ButtonBack}" \
			--extra-button \
			--extra-label "$(gettext 'Reset')" \
			--backtitle "$ccabec" \
			--insecure "$@" \
			--mixedform "${cmsg_MENU}\n\n$(gettext "O tamanho das partições é uma questão de preferência pessoal.")" \
			0 0 0 \
			"${formargs[@]}" \
			2>&1 1>&3)

		exit_status=$?
		# fd 3 só serve pro dialog acima. Fechando aqui, os nove return 1
		# espalhados pelas validações abaixo não precisam se lembrar dele.
		exec 3>&-

		case $exit_status in
		"$D_EXTRA")
			# "Reset": volta tudo pro estado inicial, como se nada tivesse
			# sido configurado ainda — não confirma nem cancela, só limpa.
			AConfFde[vg]=''
			AConfFde[passphrase]='voidlinux'
			AConfFde[verifypassphrase]='voidlinux'
			AConfFde[lvroot]='100%'
			AConfFde[lvboot]=''
			AConfFde[lvswap]=''
			AConfFde[lvvar]=''
			AConfFde[lvhome]=''
			LFDE=false
			LVM=false
			return 1
			;;
		"$D_ESC" | "$D_CANCEL")
			LFDE=false
			LVM=false
			return 1
			;;
		"$D_OK")
			mapfile -t arr <<<"$FdeText"
			AConfFde[vg]="${arr[$idx_vg]}"
			if [[ "$idx_pass" -ge 0 ]]; then
				AConfFde[passphrase]="${arr[$idx_pass]}"
				AConfFde[verifypassphrase]="${arr[$idx_verify]}"
			fi
			AConfFde[lvroot]="${arr[$idx_lvroot]}"
			AConfFde[lvboot]="${arr[$idx_lvboot]}"
			AConfFde[lvswap]="${arr[$idx_lvswap]}"
			AConfFde[lvvar]="${arr[$idx_lvvar]}"
			AConfFde[lvhome]="${arr[$idx_lvhome]}"
			AConfFde[partition]="$_part"

			# Descobre se a PARTIÇÃO ALVO já faz parte de algum VG — não importa
			# o nome. Digitar um nome novo ("xfce") pra uma partição que já tem
			# um VG antigo ("voidbrvm") faz a limpeza por nome não achar nada
			# (o nome novo ainda não existe), deixando o antigo intocado e
			# ativo — confirmado travando o pvcreate/vgcreate mais adiante numa
			# tentativa real. Pergunta antes de qualquer coisa, deixando claro
			# o que vai acontecer.
			sh_fix_scan_lvs
			_old_vg=$(pvs --noheadings -o pv_name,vg_name 2>/dev/null | awk -v part="${AConfFde[partition]}" '$1==part{print $2}')
			if [[ -n "$_old_vg" && "$_old_vg" != "${AConfFde[vg]}" ]]; then
				if ! conf "=== $ctitlemenu ===" \
					"\n${YELLOW}$(gettext 'Já existe um Volume Group') '$_old_vg' $(gettext 'associado a esse disco.')${RST}" \
					"\n\n${BOLD}${WHITE}$(gettext 'Deseja prosseguir e recriar?')\n\n"; then
					continue
				fi
			fi

			# "0" ou "0%" equivale a deixar em branco (sem volume separado) — o
			# código de criação dos volumes só olha se está vazio ou não, então
			# normaliza aqui pra não tentar criar um volume de tamanho zero.
			# (a explicação de como preencher já foi mostrada na entrada da tela)
			local _lvfield _lvval
			for _lvfield in lvboot lvswap lvvar lvhome; do
				_lvval="${AConfFde[$_lvfield]}"
				if [[ "$_lvval" == "0" || "$_lvval" == "0%" ]]; then
					AConfFde[$_lvfield]=''
				fi
			done

			# Aceita digitar só o número (ex: "25"), sem precisar do "%" no
			# final — completa automaticamente aqui, só na hora de usar de
			# verdade. Não mexe em quem já digitou "%" ou tamanho absoluto
			# (ex: "10G").
			for _lvfield in lvroot lvboot lvswap lvvar lvhome; do
				_lvval="${AConfFde[$_lvfield]}"
				if [[ -n "$_lvval" && "$_lvval" =~ ^[0-9]+$ ]]; then
					AConfFde[$_lvfield]="${_lvval}%"
				fi
			done

			# Mostra um resumo do que foi preenchido e confirma antes de seguir
			# pra criação de verdade — se recusar, volta pro formulário com os
			# valores exatamente como foram digitados.
			local _line_vg _line_root _line_boot _line_swap _line_var _line_home
			_line_vg="$(padr 'Volume Group :' 15 ' ') ${AConfFde[vg]}"
			_line_root="$(padr 'root :' 15 ' ') ${AConfFde[lvroot]}"
			_line_boot="$(padr 'boot :' 15 ' ') ${AConfFde[lvboot]:-$(gettext '(nenhum)')}"
			_line_swap="$(padr 'swap :' 15 ' ') ${AConfFde[lvswap]:-$(gettext '(nenhum)')}"
			_line_var="$(padr 'var :' 15 ' ') ${AConfFde[lvvar]:-$(gettext '(nenhum)')}"
			_line_home="$(padr 'home :' 15 ' ') ${AConfFde[lvhome]:-$(gettext '(nenhum)')}"

			local _origroot="${AConfFde[lvroot]}" _origboot="${AConfFde[lvboot]}" _origswap="${AConfFde[lvswap]}" _origvar="${AConfFde[lvvar]}" _orighome="${AConfFde[lvhome]}"

			lvunitroot="${AConfFde[lvroot]: -1}"
			lvsizeroot="${AConfFde[lvroot]%$lvunitroot}"
			lvunitboot="${AConfFde[lvboot]: -1}"
			lvsizeboot="${AConfFde[lvboot]%$lvunitboot}"
			lvunitswap="${AConfFde[lvswap]: -1}"
			lvsizeswap="${AConfFde[lvswap]%$lvunitswap}"
			lvunitvar="${AConfFde[lvvar]: -1}"
			lvsizevar="${AConfFde[lvvar]%$lvunitvar}"
			lvunithome="${AConfFde[lvhome]: -1}"
			lvsizehome="${AConfFde[lvhome]%$lvunithome}"
			maxbytespartition="$(sh_toBytes "$size")"
			byteslvroot="$(sh_toBytesPercent "${AConfFde[lvroot]}" "$maxbytespartition")"
			byteslvboot="$(sh_toBytesPercent "${AConfFde[lvboot]}" "$maxbytespartition")"
			byteslvswap="$(sh_toBytesPercent "${AConfFde[lvswap]}" "$maxbytespartition")"
			byteslvvar="$(sh_toBytesPercent "${AConfFde[lvvar]}" "$maxbytespartition")"
			byteslvhome="$(sh_toBytesPercent "${AConfFde[lvhome]}" "$maxbytespartition")"

			# (partição já ser PV é esperado ao reinstalar no mesmo disco — a
			# limpeza em sh_make_fsLvm/sh_install já trata isso de verdade,
			# sem precisar perguntar algo assustador aqui no meio do formulário)

			# (a checagem de VG duplicado já foi feita antes da confirmação,
			# usando vgscan -vvv e sabendo distinguir mesmo disco de disco
			# diferente — não precisa repetir aqui com um snapshot velho)

			if [[ -z "${AConfFde[vg]}" ]]; then
				if ! conf "=== FDE/LVM - $(gettext "Grupo de Volume") === " \
					"\nVolume Group = '${AConfFde[vg]}'\n$(gettext "O nome do grupo de volumes não pode estar vazio.")\n\n${BOLD}${RED}$(gettext "Novamente?")\n\n"; then
					LFDE=false
					LVM=false
					return 1
				fi
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			if [[ $maxbytespartition -lt $((byteslvroot + byteslvboot + byteslvswap + byteslvhome + byteslvvar)) ]]; then
				local _sum_bytes=$((byteslvroot + byteslvboot + byteslvswap + byteslvhome + byteslvvar))
				local _deficit_bytes=$((maxbytespartition - _sum_bytes))
				local _deficit_human _sum_lines _sl_device _sl_part _sl_root _sl_boot _sl_swap _sl_var _sl_home _sl_soma
				_deficit_human=$(numfmt --to=iec --suffix=B -- "$_deficit_bytes" 2>/dev/null)
				_sl_device="${CYAN}$(padr "$(gettext 'Device :')" 15 ' ')${RST} ${YELLOW}${AConfFde[partition]}${RST}"
				_sl_part="${CYAN}$(padr "$(gettext 'Tamanho :')" 15 ' ')${RST} ${YELLOW}${size}${RST}"
				_sum_lines="${_sl_device}\n${_sl_part}"
				if [[ -n "${AConfFde[lvroot]}" ]]; then
					_sl_root="${CYAN}$(padr '/root :' 15 ' ')${RST} ${YELLOW}${AConfFde[lvroot]}${RST}"
					_sum_lines+="\n${_sl_root}"
				fi
				if [[ -n "${AConfFde[lvboot]}" ]]; then
					_sl_boot="${CYAN}$(padr '/boot :' 15 ' ')${RST} ${YELLOW}${AConfFde[lvboot]}${RST}"
					_sum_lines+="\n${_sl_boot}"
				fi
				if [[ -n "${AConfFde[lvswap]}" ]]; then
					_sl_swap="${CYAN}$(padr '/swap :' 15 ' ')${RST} ${YELLOW}${AConfFde[lvswap]}${RST}"
					_sum_lines+="\n${_sl_swap}"
				fi
				if [[ -n "${AConfFde[lvvar]}" ]]; then
					_sl_var="${CYAN}$(padr '/var :' 15 ' ')${RST} ${YELLOW}${AConfFde[lvvar]}${RST}"
					_sum_lines+="\n${_sl_var}"
				fi
				if [[ -n "${AConfFde[lvhome]}" ]]; then
					_sl_home="${CYAN}$(padr '/home :' 15 ' ')${RST} ${YELLOW}${AConfFde[lvhome]}${RST}"
					_sum_lines+="\n${_sl_home}"
				fi
				_sl_soma="${CYAN}$(padr "$(gettext 'Soma :')" 15 ' ')${RST} ${YELLOW}${_deficit_human}${RST}"
				_sum_lines+="\n\n${_sl_soma}"
				if ! conf "=== FDE/LVM - $(gettext "Volumes lógicos") === " \
					"\n$(gettext "A soma das partições excede o tamanho da partição de destino.")\n\n${_sum_lines}\n\n${BOLD}${RED}$(gettext "Novamente?")\n\n"; then
					LFDE=false
					LVM=false
					return 1
				fi
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			if [[ -z "$lvunitroot" || "$lvunitroot" != @(K|M|G|T|%) ]]; then
				if ! conf "=== FDE/LVM - $(gettext "Volume lógico raiz") === " \
					"\n$(gettext "O volume lógico root não pode ficar vazio, nem ter tamanho ou unidade fora do padrão (K|M|G|T|%).")\nex: 25% [1-100]% ou 10G [1-n](K|M|G|T).\n\n${BOLD}${RED}$(gettext "Novamente?")\n\n"; then
					LFDE=false
					LVM=false
					return 1
				fi
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			if [[ -n "$lvunitboot" && "$lvunitboot" != @(K|M|G|T|%) ]]; then
				if ! conf "=== FDE/LVM - $(gettext "Volume lógico") boot === " \
					"\n$(gettext "O volume lógico boot não pode ter tamanho ou unidade fora do padrão (K|M|G|T|%).")\nex: 25% [1-100]% ou 10G [1-n](K|M|G|T).\n\n${BOLD}${RED}$(gettext "Novamente?")\n\n"; then
					LFDE=false
					LVM=false
					return 1
				fi
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			if [[ -n "$lvunitswap" && "$lvunitswap" != @(K|M|G|T|%) ]]; then
				if ! conf "=== FDE/LVM - $(gettext "Volume lógico") swap === " \
					"\n$(gettext "O volume lógico swap não pode ter tamanho ou unidade fora do padrão (K|M|G|T|%).")\nex: 25% [1-100]% ou 10G [1-n](K|M|G|T).\n\n${BOLD}${RED}$(gettext "Novamente?")\n\n"; then
					LFDE=false
					LVM=false
					return 1
				fi
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			if [[ -n "$lvunithome" && "$lvunithome" != @(K|M|G|T|%) ]]; then
				if ! conf "=== FDE/LVM - $(gettext "Volume lógico") home === " \
					"\n$(gettext "O volume lógico home não pode ter tamanho ou unidade fora do padrão (K|M|G|T|%).")\nex: 25% [1-100]% ou 10G [1-n](K|M|G|T).\n\n${BOLD}${RED}$(gettext "Novamente?")\n\n"; then
					LFDE=false
					LVM=false
					return 1
				fi
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			if [[ -n "$lvunitvar" && "$lvunitvar" != @(K|M|G|T|%) ]]; then
				if ! conf "=== FDE/LVM - $(gettext "Volume lógico") var === " \
					"\n$(gettext "O volume lógico var não pode ter tamanho ou unidade fora do padrão (K|M|G|T|%).")\nex: 25% [1-100]% ou 10G [1-n](K|M|G|T).\n\n${BOLD}${RED}$(gettext "Novamente?")\n\n"; then
					LFDE=false
					LVM=false
					return 1
				fi
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			if [[ -z "${AConfFde[passphrase]}" || "${AConfFde[passphrase]}" != "${AConfFde[verifypassphrase]}" ]]; then
				if ! conf "=== FDE/LVM - $(gettext "Senha") === " \
					"\n$(gettext "As senhas não conferem, ou estão vazias.")\n\n${BOLD}${RED}$(gettext "Novamente?")\n\n"; then
					LFDE=false
					LVM=false
					return 1
				fi
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			# Só mostra o resumo pra confirmar DEPOIS de todas as validações
			# acima passarem — evita o usuário confirmar "prosseguir" e, logo
			# em seguida, cair num erro de validação que já era conhecido antes
			# mesmo de perguntar (ex: soma excede o disco).
			if ! conf "=== $ctitlemenu - $(gettext 'Confirmação') ===" \
				"\n$(gettext 'Confira antes de prosseguir:')\n" \
				"\n${CYAN}${_line_vg}${RST}" \
				"\n${CYAN}${_line_root}${RST}\n${CYAN}${_line_boot}${RST}\n${CYAN}${_line_swap}${RST}\n${CYAN}${_line_var}${RST}\n${CYAN}${_line_home}${RST}" \
				"\n\n${BOLD}${RED}$(gettext 'Deseja prosseguir com essa configuração?')\n\n"; then
				AConfFde[lvroot]="$_origroot"
				AConfFde[lvboot]="$_origboot"
				AConfFde[lvswap]="$_origswap"
				AConfFde[lvvar]="$_origvar"
				AConfFde[lvhome]="$_orighome"
				continue
			fi

			# O usuário digita pensando em "% do disco total" (ex: root=25% =
			# 1/4 do disco) — mas o lvcreate usa "%FREE" (% do que ainda está
			# livre no momento da criação, na ordem fixa root->boot->swap->
			# var->home). Converte aqui, andando na mesma ordem, descontando
			# tamanhos absolutos (ex: "10G") do que sobra em bytes, sem
			# convertê-los pra %FREE (esses usam -L direto, sem cálculo).
			#
			# NUNCA sobrescreve AConfFde[lv*] com o valor convertido — isso é
			# salvo no .conf e reaparece no formulário se o usuário reabrir pra
			# editar depois (confirmado causando confusão: usuário digitou
			# 25/5/70 e via 25%/7%/100% ao reabrir). O convertido fica isolado
			# em _conv, usado só na construção do AmntpointFDE logo abaixo.
			local -A _conv=([lvroot]="${AConfFde[lvroot]}" [lvboot]="${AConfFde[lvboot]}" [lvswap]="${AConfFde[lvswap]}" [lvvar]="${AConfFde[lvvar]}" [lvhome]="${AConfFde[lvhome]}")
			local _lvseq=(lvroot lvboot lvswap lvvar lvhome)
			local _remaining_bytes="$maxbytespartition"
			local _f _v _bytes_needed _pct_free
			for _f in "${_lvseq[@]}"; do
				_v="${AConfFde[$_f]}"
				[[ -z "$_v" ]] && continue
				_bytes_needed=$(sh_toBytesPercent "$_v" "$maxbytespartition")
				if [[ "$_v" == *% ]]; then
					if [[ "$_remaining_bytes" -gt 0 ]]; then
						_pct_free=$(awk -v b="$_bytes_needed" -v r="$_remaining_bytes" 'BEGIN{printf "%.0f", (b/r)*100}')
					else
						_pct_free=0
					fi
					_conv[$_f]="${_pct_free}%"
				fi
				# tamanho absoluto: mantém como está em _conv (lvcreate usa -L
				# direto), só desconta do que resta pros percentuais seguintes.
				_remaining_bytes=$((_remaining_bytes - _bytes_needed))
			done

			AmntpointFDE=()
			AmntpointFDE+=(["/dev/${AConfFde[vg]}/root"]="root|$fstype|1|${_conv[lvroot]}|/")
			[[ -n "${AConfFde[lvboot]}" ]] && AmntpointFDE+=(["/dev/${AConfFde[vg]}/boot"]="boot|$fstype|1|${_conv[lvboot]}|/boot")
			[[ -n "${AConfFde[lvswap]}" ]] && AmntpointFDE+=(["/dev/${AConfFde[vg]}/swap"]="swap|swap|1|${_conv[lvswap]}|swap")
			[[ -n "${AConfFde[lvvar]}" ]] && AmntpointFDE+=(["/dev/${AConfFde[vg]}/var"]="var|$fstype|1|${_conv[lvvar]}|/var")
			[[ -n "${AConfFde[lvhome]}" ]] && AmntpointFDE+=(["/dev/${AConfFde[vg]}/home"]="home|$fstype|1|${_conv[lvhome]}|/home")
			;;
		esac
		if ((LCONFIGFDE)); then
			LFDE=true
			LVM=true
		else
			LFDE=false
			LVM=true
		fi
		return 0
	done
}

sh_make_fsFde() {
	local i
	local format
	local fstype
	local _part
	local label

	# Cobre o caso de reaproveitar uma tabela de partições de um teste
	# anterior sem reparticionar (sh_close_stale_crypto só rodava ligada ao
	# sh_mkparted) — sem isso, um LUKS/VG remanescente ainda ativo em cima
	# dessa mesma partição faz o luksFormat falhar com "dispositivo em uso".
	sh_close_stale_crypto "${AConfFde[partition]}"

	sh_info_msg "Formatando e cryptografando a unidade : ${AConfFde[partition]}"
	printf "${AConfFde[passphrase]}" | cryptsetup luksFormat --type luks1 --batch-mode "${AConfFde[partition]}" --key-file=- -v 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
	evaluate_retval "${PIPESTATUS[1]}"

	sh_info_msg "Abrindo a unidade cryptografada: ${AConfFde[partition]}"
	printf "${AConfFde[passphrase]}" | cryptsetup luksOpen "${AConfFde[partition]}" "${AConfFde[vg]}" --key-file=- -v 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
	evaluate_retval "${PIPESTATUS[1]}"
}

# Só é preciso ajustar quando o disco ALVO da instalação é ele mesmo uma
# LV (ex: instalando dentro de um LV do Proxmox no host, disco aninhado)
# — dentro de uma VM normal, o disco é bruto (/dev/sda, /dev/vda), sem
# aninhamento nenhum, e essa configuração não faz diferença. Causa raiz
# confirmada manualmente: com scan_lvs=0 (padrão da maioria das
# distros), o LVM não rastreia de forma confiável PVs/VGs que moram
# DENTRO de outra LV — vgscan até encontra, mas vgs/lvcreate/vgchange
# normais "perdem" a referência logo depois. Idempotente — chamar mais
# de uma vez não tem efeito colateral (só reajusta se ainda estiver 0).
sh_fix_scan_lvs() {
	if [[ "$(lsblk -no TYPE "${AConfDisk[_DEVICE]}" 2>/dev/null)" = "lvm" ]]; then
		if grep -qE '^\s*#?\s*scan_lvs\s*=\s*0' /etc/lvm/lvm.conf 2>/dev/null; then
			sed -i -E 's/^\s*#?\s*scan_lvs\s*=\s*0/\tscan_lvs = 1/' /etc/lvm/lvm.conf
		fi
	fi
}

sh_make_fsLvm() {
	local i
	local _part
	local label
	local fstype
	local format
	local size
	local mntpoint
	local lvunit
	local aLVs=()

	# Ajusta scan_lvs (ver comentário em sh_fix_scan_lvs, logo acima) —
	# idempotente, não tem problema já ter sido ajustado antes em sh_install.
	sh_fix_scan_lvs

	# Cobre instalação anterior abortada sem limpar: VG/LVM (ou LUKS) que
	# ficou pendurado no mesmo dispositivo, travando o pvcreate/vgcreate a
	# seguir com "dispositivo ocupado". Roda pros dois casos (com ou sem
	# LFDE), já que sh_close_stale_crypto (chamada dentro de sh_make_fsFde)
	# só cobre o caminho com LUKS.
	sh_close_stale_crypto "${AConfFde[partition]}"
	sh_close_stale_lvm "${AConfFde[partition]}"

	# pvs/vgs às vezes "não enxergam" um VG que existe de verdade (cache
	# desatualizado, visto repetidamente em testes) — por isso sh_close_stale_lvm
	# (que depende de pvs pra descobrir o VG) pode não achar nada pra limpar.
	# vgremove -ff direto pelo nome esperado se mostrou confiável mesmo
	# nesses casos — tenta incondicionalmente, sem depender de descoberta
	# prévia (remover algo que não existe é inofensivo, só falha e segue).
	vgchange -an "${AConfFde[vg]}" >/dev/null 2>&1
	vgremove -ff "${AConfFde[vg]}" >/dev/null 2>&1

	if $LFDE; then
		sh_make_fsFde
	fi

	if $LFDE; then
		:
	else
		sh_info_msg "Criando a unidade fisica LVM: ${AConfFde[vg]}"
		pvcreate -ff "${AConfFde[partition]}" 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
		evaluate_retval "${PIPESTATUS[0]}"
	fi

	sh_info_msg "Criando o grupo de volumes LVM: ${AConfFde[vg]}"
	if $LFDE; then
		vgcreate -ff "${AConfFde[vg]}" "/dev/mapper/${AConfFde[vg]}" 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
	else
		vgcreate -ff "${AConfFde[vg]}" "${AConfFde[partition]}" 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
	fi
	evaluate_retval "${PIPESTATUS[0]}"

	#order required for creation due to issue of 100%
	aLVs=("/dev/${AConfFde[vg]}/root" "/dev/${AConfFde[vg]}/boot" "/dev/${AConfFde[vg]}/swap" "/dev/${AConfFde[vg]}/var" "/dev/${AConfFde[vg]}/home")

	# Duas passadas: primeiro cria todos os LVs, só depois formata cada um
	# — mais organizado que intercalar criação e formatação item a item.
	for i in "${aLVs[@]}"; do
		_part="$i"
		size="$(sh_splitarray "${AmntpointFDE[$i]}" 4)"
		lvunit="${size: -1}"

		[[ -z "$size" ]] && continue

		label="$(sh_splitarray "${AmntpointFDE[$i]}" 1)"
		sh_info_msg "Criando o volume lógico: $label"
		if [[ "$lvunit" = "%" ]]; then
			lvcreate --yes --name "$label" -l "${size}FREE" "${AConfFde[vg]}" 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
		else
			lvcreate --yes --name "$label" -L "${size}" "${AConfFde[vg]}" 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
		fi
		evaluate_retval "${PIPESTATUS[0]}"
	done

	for i in "${aLVs[@]}"; do
		_part="$i"
		label="$(sh_splitarray "${AmntpointFDE[$i]}" 1)"
		fstype="$(sh_splitarray "${AmntpointFDE[$i]}" 2)"
		format="$(sh_splitarray "${AmntpointFDE[$i]}" 3)"
		size="$(sh_splitarray "${AmntpointFDE[$i]}" 4)"
		mntpoint="$(sh_splitarray "${AmntpointFDE[$i]}" 5)"

		[[ -z "$size" ]] && continue

		if [[ "$format" = "1" ]]; then
			sh_info_msg "${cmsg_FormatandoParticao} ${_part} FS ${fstype,,}"
			declare -A fsparms=(
				[ext2]="-F   -L $label"
				[ext3]="-F   -L $label"
				[ext4]="-F   -L $label"
				[btrfs]="-f   -L $label"
				[f2fs]="-f   -l $label"
				[xfs]="-f   -L $label"
				[jfs]="-f   -L $label"
				[vfat]="-F32 -n EFI"
				[reiserfs]="-f   -l $label"
			)
			if [[ "$fstype" = "swap" ]]; then
				mkswap "$_part" 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
			else
				mkfs.$fstype ${fsparms[$fstype]} $_part 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
			fi
			evaluate_retval "${PIPESTATUS[0]}"
		fi

	done
	_arch=$(xbps-uhelper arch)
	export XBPS_ARCH=${_arch}
	return 0
}

sh_clearVg() {
	local _vg="$1"
	local i

	sh_umount_fs

	# vgremove -ff já remove as LVs de dentro do VG sozinho — um lvremove
	# separado antes dele é redundante e, na prática, batia no mesmo
	# problema de cache do LVM que motivou essa função (relatava "VG not
	# found" mesmo com o VG existindo de verdade, gerando um [ FAIL ]
	# confuso no log por nada).
	vgchange -an "$_vg" >/dev/null 2>&1

	sh_info_msg "$(gettext 'Removendo VG (Volume Group)')"
	vgremove -ff "$_vg" 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
	evaluate_retval "${PIPESTATUS[0]}" "$err_not_fatal"

	sh_info_msg "$(gettext 'Removendo PVs (Volumes Fisícos)')"
	pvremove -ff "${AConfFde[partition]}" 2>&1 | tee -i -a "$BOOTLOG" >"$LOGGER"
	evaluate_retval "${PIPESTATUS[0]}" "$err_not_fatal"
}

sh_chooseVg() {
	local -A Avg
	local -A Aflag
	local array=()
	local defaultitem
	local fields
	local sorted_list
	local exit_status
	local sep="\xe2\x94\x82"

	sh_vg_info
	sorted_list=$(for key in "${!AARRAY_VG_DEVICES[@]}"; do echo "$key|${AARRAY_VG_DEVICES[$key]}"; done | sort -t\| -k2 -k1)

	if [[ ${#sorted_list} -eq 0 ]]; then
		alerta "=== VG ===" "${BOLD}${BLACK}${REVERSE}$(gettext "Info: Nenhum VG localizado no sistema.")"
		return 1
	fi

	defaultitem="${AConfFde[vg]}"
	while IFS='|' LC_ALL=C read -r -a fields; do
		x="${fields[0]}"
		Aflag[$x]='off'
		Aflag[$defaultitem]='on'
		array+=("$x" "$(printf "$sep%-15s$sep%10s$sep%10s$sep%-s" \
			"${fields[1]}" \
			"${fields[2]}" \
			"${fields[3]}" \
			"${fields[4]}")"
		"${Aflag[$x]}")
	done <<<"${sorted_list[@]}"

	vg=$(${DIALOG} --title "=== VG ===" \
		--colors \
		--cancel-label "${cmsg_ButtonBack}" \
		--ok-label "${cmsg_Aceitar}" \
		--radiolist "${cmsg_MENU}" \
		25 70 24 "${array[@]}" 2>&1 >/dev/tty)

	exit_status=$?
	case $exit_status in
	"$D_ESC" | "$D_CANCEL")
		return
		;;
	esac
	if ! infoconf "=== VG === " "$(lvs --noheadings "$vg")" \
		" === VG ===" "${BOLD}${RED}$(gettext 'AVISO'):${RESET} $(gettext "É importante lembrar que remover um VG")\
$(gettext "é uma operação irreversível e pode resultar em perda de dados.")\n
$(gettext "Certifique-se de fazer backup de seus dados.")\n
$(gettext "Todos os dados do disco serão apagados!")\n\n\
${BOLD}${WHITE}$(gettext "Deseja continuar?")"; then
		return 1
	fi
	sh_clearVg "$vg"
}

