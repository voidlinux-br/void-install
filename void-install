die() {
	local msg
	local erros
	local logsection
	local l

	if test $# -ge 2; then
		evaluate_retval 1
	fi

	# Antes só usava "$1" — se a chamada passasse um 2º argumento (ex: título
	# + motivo do erro), o motivo era descartado silenciosamente e o usuário
	# nunca via por que a instalação parou.
	msg="$(printf '%s\n' "$@")"

	# Tenta achar o bloco da falha de verdade (a linha "[ FAIL ]" e o que veio
	# logo antes dela, onde fica a saída real do comando que falhou). Se não
	# achar nenhum "[ FAIL ]" (ex: die chamado por escolha do usuário, sem
	# comando ter falhado), cai no fallback de mostrar as últimas linhas.
	mapfile -t erros < <(grep -B 20 -F '[ FAIL ]' "$BOOTLOG" | tail -n 30)
	if [[ "${#erros[@]}" -eq 0 ]]; then
		mapfile -t erros < <(tail -n 20 "$BOOTLOG")
	fi

	# Testado à exaustão: nem --textbox nem --programbox interpretam "\Z"
	# nem ANSI real vindo de arquivo/pipe — só texto passado direto como
	# argumento (--msgbox) aceita cor de verdade. O motivo de termos saído
	# do --msgbox antes era ele cortar conteúdo maior que a caixa — mas com
	# a altura generosa (bem acima do teto de ~30 linhas do mapfile acima),
	# testado e confirmado: cabe tudo, nada fica escondido, e sai colorido
	# de verdade. Cada linha ganha cor conforme o tipo, pra não ficar tudo
	# vermelho: FAIL é o que realmente importa, o resto é contexto.
	logsection=""
	for l in "${erros[@]}"; do
		case "$l" in
		*"[ FAIL ]"*) logsection+="${RED}${l}${RST}\n" ;;
		*"[  OK  ]"*) logsection+="${GREEN}${l}${RST}\n" ;;
		*"[ INFO ]"*) logsection+="${CYAN}${l}${RST}\n" ;;
		"####"*) logsection+="${l}\n" ;;
		*) logsection+="${YELLOW}${l}${RST}\n" ;;
		esac
	done

	if has_command dialog; then
		${DIALOG} --title "ERRO" --colors --msgbox "\n${BOLD}${RED}${msg}${RST}\n\n--- $(gettext 'Últimas linhas registradas') ---\n${logsection}" 40 150
	else
		printf "%-75s\n" "$(DOT)${bold}${red}$msg${reset}" >&2
	fi
	sh_enablePrintk
	exit 1
}

DOT() {
	printf "%s" "${blue}:: ${reset}"
}

