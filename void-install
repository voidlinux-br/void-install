sh_choose_disk() {
	local old_device="${AConfDisk[_DEVICE]}"

	sh_umount_fs

	while true; do
		sh_disk_part_info
		local array=()
		local i
		local n=0
		local nlen=0
		local nc=0
		local result
		local sep="\xe2\x94\x82"
		local xtitle
		local LCHOOSEBOOTLOADER=0
		local LCHOOSEHEALTH=false

		if [ $# -eq 0 ]; then
			xtitle="${cmsg_TitleDisco}"
			LCHOOSEBOOTLOADER=0
			LCHOOSEHEALTH=false
		else
			if [[ "$1" == "${cmsg_DiskHealth}" ]]; then
				xtitle="${cmsg_DiskHealth^^}"
				LCHOOSEHEALTH=true
			else
				xtitle="${cmsg_BootLoader^^}"
				LCHOOSEBOOTLOADER=1
			fi
		fi

		for i in "${ARRAY_DSK_DEVICES[@]}"; do
			array[n++]="$i"
			if ((nlen < ${#i})); then
				nlen=${#i}
			fi
			array[n++]=$(printf "$sep%-4s$sep%-6s$sep%6s$sep%-6s$sep%-15s$sep%-30s" \
				"$(sh_getlgrub "$i")" \
				"${ARRAY_DSK_TRAN[$nc]}" \
				"${ARRAY_DSK_SIZE[$nc]}" \
				"${ARRAY_DSK_PTTYPE[$nc]}" \
				"${ARRAY_DSK_LABEL[$nc]}" \
				"${ARRAY_DSK_MODEL[$nc]}")
			((nc++))
		done
		((nlen += 6))
		sd=$(${DIALOG} \
			--default-item "${AConfDisk[_DEVICE]}" \
			--backtitle "$ccabec" \
			--title "$xtitle" \
			--ok-label "${cmsg_ButtonSelecionar}" \
			--cancel-label "${cmsg_ButtonBack}" \
			--colors \
			--extra-button \
			--extra-button --extra-label "$(gettext 'Particionamento')" \
			--menu "${cmsg_MENU}\n\n\
$(printf "%${nlen}s$sep%-4s$sep%-6s$sep%6s$sep%-6s$sep%-15s$sep%-30s" "DEVICE" "BOOT" "TRAN" "SIZE" "PTTYPE" "LABEL" "MODEL")" \
			24 0 2 "${array[@]}" 2>&1 >/dev/tty)

		exit_status=$?
		case $exit_status in
		"$D_ESC" | "$D_CANCEL")
			return 1
			;;
		esac

		if [[ -n "$sd" ]]; then
			if $LCHOOSEHEALTH; then
				AConfDisk[_HEALTH]="$sd"
				return 0
			fi

			if ((LCHOOSEBOOTLOADER)); then
				AConfDisk[_BOOTLOADER]="$sd"
				LGRUB=true
				LOSPROBER=false
				return 0
			fi

			AConfDisk[_DEVICE]="$sd"
			AConfDisk[_BOOTLOADER]="$sd"
			AConfDisk[_HEALTH]="$sd"
			index=$(sh_seekstrarray "${ARRAY_DSK_DEVICES[*]}" "${AConfDisk[_DEVICE]}")
			NAME_ORIGEM="$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_DEVICE]}]}" "$DSK_NAME")"
			MODEL_ORIGEM="$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_DEVICE]}]}" "$DSK_MODEL")"
			SIZE_ORIGEM="$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_DEVICE]}]}" "$DSK_SIZE")"
			TRAN_ORIGEM="$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_DEVICE]}]}" "$DSK_TRAN")"
			LDISK=true
			LGRUB=true
			[[ "$old_device" != "${AConfDisk[_DEVICE]}" ]] && LFSREVISED=false
		fi

		set_disk_choosed() {
			AConfDisk[_DEVICE]="$sd"
			AConfDisk[_BOOTLOADER]="$sd"
			AConfDisk[_HEALTH]="$sd"
			sh_checkdisk "$sd"
			sh_backup_partitions "$sd" "$NAME_ORIGEM"
			LDISK=true
			LGRUB=true
			LOSPROBER=false
			[[ "$old_device" != "${AConfDisk[_DEVICE]}" ]] && LFSREVISED=false

			#     if [[ "${#Amntpoint[@]}" -eq 0 ]]; then
			#	    if [[ "$old_device" != "${AConfDisk[_DEVICE]}" || ! $LFSREVISED ]]; then
			#	    if ! $LFSREVISED; then
			#     if [[ "${#Amntpoint[@]}" -eq 0 ]]; then
			# Sempre reconstrói: não confiar em "${AsFs[_DEVICE]}" == mesmo disco,
			# pois esse valor pode ter sido restaurado de uma execução anterior
			# (/tmp/void-install.conf) enquanto o disco físico mudou de conteúdo
			# (ex: já tem um LUKS de um teste anterior).
			sh_rebuild_amntpoint_for_new_disk
			AsFs[_DEVICE]="$sd"
		}

		case $exit_status in
		"$D_OK")
			set_disk_choosed

			if ! $LMKPARTED; then
				if conf "${xtitle} ${sd}" \
					"\n$(gettext 'O disco selecionado parece estar vazio ou sem partições configuradas.')" \
					"\n$(gettext 'Para continuar a instalação, é necessário criar as partições.')" \
					"\n\n${BOLD}${RED}$(gettext 'Deseja abrir as ferramentas de particionamento agora?')"; then
					sh_checkdisk "${AConfDisk[_DEVICE]}"
					sh_menuUtilDisk
					#continue
					set_disk_choosed # qui 07 mai 2026 21:22:11 -04
					return 0         # qui 07 mai 2026 21:22:11 -04
				fi

			fi
			return 0
			;;
		"$D_CONFIG")
			sh_checkdisk "${AConfDisk[_DEVICE]}"
			sh_menuUtilDisk
			#continue
			set_disk_choosed # qui 07 mai 2026 21:22:11 -04
			return 0         # qui 07 mai 2026 21:22:11 -04
			;;
		esac
	done
	LDISK=true
	LFSREVISED=false
	return 0
}

