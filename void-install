}

sh_build_and_apply_dhcpcd_config() {
	local CONFIG_FILE="$dir_install/etc/dhcpcd.conf"
	local BACKUP_FILE="${CONFIG_FILE}.$(sh_diahora)"

	sh_info_msg "%(gettext 'Aplicando configuração do dhcpd')"
	# backup somente se existir
	if [[ -f "$CONFIG_FILE" ]]; then
		mv -f "$CONFIG_FILE" "$BACKUP_FILE"
	fi

	# cria novo arquivo
	cat >"$CONFIG_FILE" <<EOF
# See dhcpcd.conf(5) for details.

interface ${AsDhcp[IFACE]}
static ip_address=${AsDhcp[IP]}/${AsDhcp[CIDR]}
static routers=${AsDhcp[GATEWAY]}
static domain_name_servers=${AsDhcp[DNS1]} ${AsDhcp[DNS2]}
EOF

}

