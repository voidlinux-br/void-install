# Se LVM/FDE está ativo, reparticiona do zero antes de seguir — em vez
# de tentar limpar cirurgicamente resíduo de VG/LUKS de testes
# anteriores (não confiável, cache do LVM já mostrou inconsistência
# várias vezes), recriar a tabela de partição inteira garante disco
# limpo de verdade. Desmonta antes: se sobrou algo montado de uma
# sessão anterior (ex: instalação abortada), o kernel recusa atualizar
# a tabela de partição enquanto a partição antiga estiver em uso.
sh_prepare_lvm_fde_disk() {
	local _pvs_output _old_vg _vg_pv _vg_a_remover

	sh_umount_fs

	# Ajusta scan_lvs ANTES de qualquer checagem de VG — sem isso, pvs/vgs
	# comuns não são confiáveis num disco aninhado (ver sh_fix_scan_lvs).
	sh_fix_scan_lvs

	# Uma consulta só, usada pras duas coisas abaixo:
	_pvs_output=$(pvs --noheadings -o pv_name,vg_name 2>/dev/null)

	# 1) Descobre o VG que JÁ está na partição alvo, seja lá qual for o
	# nome dele — o usuário pode ter digitado um nome NOVO ("xfce") pra
	# um VG antigo diferente ("voidbrvm") que sobrou de um teste anterior
	# na mesma partição. Limpar pelo nome NOVO não acha nada (ainda não
	# existe) e deixa o antigo intocado e ativo — foi exatamente isso que
	# aconteceu em teste real, travando o pvcreate/vgcreate seguinte
	# tentando forçar por cima de um VG que ainda estava de pé.
	_old_vg=$(awk -v part="${AConfFde[partition]}" '$1==part{print $2}' <<<"$_pvs_output")

	# 2) Se já existe um VG com o nome NOVO configurado, mas em OUTRO
	# disco (não no que está sendo instalado agora), não remove — só um
	# alerta claro e manda reconfigurar o nome. Prefere avisar aqui a
	# deixar o vgcreate/pvcreate falhar no meio da instalação.
	_vg_pv=$(awk -v vg="${AConfFde[vg]}" '$2==vg{print $1}' <<<"$_pvs_output")
	if [[ -n "$_vg_pv" && "$_vg_pv" != "${AConfDisk[_DEVICE]}"* ]]; then
		alerta "=== $(gettext 'VOLUME GROUP') ===" \
			"\n${RED}$(gettext 'Já existe um Volume Group chamado') '${AConfFde[vg]}' $(gettext 'em outro disco') (${_vg_pv}), $(gettext 'fora do disco que está sendo instalado agora.')${RST}" \
			"\n$(gettext 'Escolha outro nome de Volume Group para continuar.')"
		if $LFDE; then menu="Fde"; else menu="Lvm"; fi
		sh_confLvm
		return 1
	fi

	# Remove o VG antigo (nome REAL descoberto acima, não o nome novo
	# digitado) e, por garantia, também tenta pelo nome novo — cobre o
	# caso normal de reinstalar reaproveitando o mesmo nome de sempre.
	for _vg_a_remover in "$_old_vg" "${AConfFde[vg]}"; do
		[[ -z "$_vg_a_remover" ]] && continue
		vgchange -an "$_vg_a_remover" >/dev/null 2>&1
		vgremove -ff "$_vg_a_remover" >/dev/null 2>&1
	done
	if $LFDE; then
		# cryptsetup luksOpen usa o nome do VG como nome do mapper LUKS
		# (ver sh_make_fsFde) — mesmo nome, camada de baixo.
		cryptsetup luksClose "${AConfFde[vg]}" >/dev/null 2>&1
	else
		pvremove -ff "${AConfFde[partition]}" >/dev/null 2>&1
	fi

	# Só reparticiona se ESSE disco específico ainda não tiver sido
	# particionado nessa sessão (sh_mkparted interativo, ao configurar
	# LVM/FDE, já faz isso — chamar de novo aqui é redundante e nem
	# existia no script original). Continua reparticionando se o disco
	# mudou depois (LMKPARTED_DEVICE não bate) ou se veio de instalação
	# silenciosa via .conf sem passar pela tela de partição nessa sessão
	# (LMKPARTED ainda false).
	if ! $LMKPARTED || [[ "$LMKPARTED_DEVICE" != "${AConfDisk[_DEVICE]}" ]]; then
		# Disco aninhado (LV do Proxmox, não um disco bruto) — mais camadas
		# de device-mapper significam mais chance do kernel ainda não ter
		# assentado essa remoção antes do sh_mkparted tentar reler a tabela
		# de partição logo a seguir (mesmo padrão de corrida visto o dia
		# inteiro nessa mesma pilha aninhada).
		udevadm settle 2>/dev/null
		sleep 1

		sh_mkparted true || return 1
	fi

	return 0
}

