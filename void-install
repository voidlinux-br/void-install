sh_getNvme() {
	local segtype
	local device="${AConfDisk[_DEVICE]}"

	segtype="$(sudo lvs "$device" -o segtype --noheadings 2>/dev/null | tr -d ' ')"

	case "$segtype" in
	thin | thin-pool)
		echo ''
		return
		;;
	esac

	local tran
	local name

	name="$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_DEVICE]}]}" $DSK_NAME)"
	tran="$(sh_splitarray "${AARRAY_DSK_DEVICES[${AConfDisk[_DEVICE]}]}" $DSK_TRAN)"

	case "$tran" in
	nvme | loop | lvm) echo 'p' ;;
	#lvm) echo '' ;;
	*)
		case "$name" in
		zram*) echo 'p' ;;
		nbd*) echo 'p' ;;
		*) echo '' ;;
		esac
		;;
	esac
}

